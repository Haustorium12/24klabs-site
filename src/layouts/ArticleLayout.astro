---
// Layout for markdown articles migrated from the gold-402 repo. Frontmatter: title, badge, meta.
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} | 24K Labs`} description={frontmatter.description || frontmatter.title}>
  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container">
      <span class="page-header__badge">{frontmatter.badge || 'Report'}</span>
      <h1 class="page-header__title">{frontmatter.title}</h1>
      {frontmatter.meta && <p class="page-header__meta">{frontmatter.meta}</p>}
    </div>
  </section>
  <section class="section--sm">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

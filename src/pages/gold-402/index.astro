---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Phase 1 (2026-07-13): /gold-402 is no longer a second directory surface — the directory
// is the homepage now. This is the single "Get Listed" page: how a service earns a spot on
// the hand-verified list. The bar is curation itself.
const BAR = [
  {
    title: 'Editorial, not algorithmic',
    desc: 'Every listing earns its place. We read the code, probe the endpoint, and write the annotation ourselves. No auto-generated descriptions, no pay-to-list.'
  },
  {
    title: 'The pawnbroker standard',
    desc: '15 years separating real gold from fake at a counter. The same eye runs this list. If it ships nothing real, it ships nothing. If the badge doesn\'t match the repo, we catch it.'
  },
  {
    title: 'It has to actually work',
    desc: 'A reachable x402 endpoint that does what it claims. Live, honestly priced, honestly labeled. "24K Verified" means a human checked it and stands behind it.'
  },
];

const STEPS = [
  { n: '1', title: 'Open a submission', desc: 'File a PR against the gold-402 repo with your service — name, endpoint, category, and a one-line description.' },
  { n: '2', title: 'We verify it', desc: 'We probe the endpoint, read the manifest, and confirm it delivers. Independent rater grades (fuchss and more) get pulled in automatically.' },
  { n: '3', title: 'It goes on the list', desc: 'Approved services render on the directory with the 24K Verified badge and any aggregated trust grades. That\'s the whole bar.' },
];
---

<BaseLayout
  title="Get Listed — Gold-402 Directory"
  description="How to get your x402 service onto the hand-verified Gold-402 Directory. Curation is the bar."
>

  <!-- HERO -->
  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container">
      <span class="page-header__badge">Get Listed</span>
      <h1 class="page-header__title">Get on the <span class="text-gold">Gold-402</span> list</h1>
      <p class="page-header__desc">
        The directory is hand-verified — being on the list is the badge. Here's how a service earns its place.
      </p>
      <div style="margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="https://github.com/Haustorium12/gold-402/blob/main/CONTRIBUTING.md"
           target="_blank" rel="noopener" class="btn btn--primary btn--lg">Submit a Service ↗</a>
        <a href="/" class="btn btn--outline btn--lg">Browse the Directory</a>
      </div>
    </div>
  </section>

  <!-- THE BAR -->
  <section class="section">
    <div class="container">
      <h2 class="section__title reveal">The bar</h2>
      <p class="section__subtitle reveal">There's no tier and no algorithm. Curation is the bar.</p>
      <div class="grid-3">
        {BAR.map(item => (
          <div class="card reveal">
            <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px;">{item.title}</h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="section" style="background: var(--bg-surface);">
    <div class="container">
      <h2 class="section__title reveal">How to get listed</h2>
      <div class="grid-3">
        {STEPS.map(s => (
          <div class="card reveal">
            <div style="color: var(--gold); font-weight: 800; font-size: 1.5rem; margin-bottom: 8px;">{s.n}</div>
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 10px;">{s.title}</h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="coming-soon reveal">
        <h2 class="coming-soon__title">Ready to submit?</h2>
        <p class="coming-soon__desc">
          Open a pull request with your service. If it's real, it gets on the list.
        </p>
        <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="https://github.com/Haustorium12/gold-402/blob/main/CONTRIBUTING.md"
             target="_blank" rel="noopener" class="btn btn--primary">Submit on GitHub ↗</a>
          <a href="/" class="btn btn--outline">Browse the Directory</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

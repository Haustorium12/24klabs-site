---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listings } from '../../lib/listings.js';
import { themeFor } from '../../lib/shelf-themes.js';

// ONE PAGE PER SHELF. Sean, 2026-08-29: "when we click on a major link I want to be taken
// to a second page with just those listings."
//
// This is the 1996 Yahoo structure and the note from that session was the important half:
// a category page was NEVER a dead end, it was another junction. Sub-categories first,
// listings under them, breadcrumb at the top, and a count beside every sibling. So every
// shelf page carries the whole shelf list in its footer rail — you can always go sideways
// without going back.
//
// The other reason these exist, from the same thread: "Static category pages are real HTML
// with real links. That's how anything ever cites us." A search result three levels deep
// lands here, not on a 500-row wall, and the page is about one thing.
//
// Prerendered at build. No JavaScript builds any of this.

export function getStaticPaths() {
  const map = new Map();
  for (const e of listings) {
    const key = e.section || 'unsorted';
    if (!map.has(key)) map.set(key, { key, label: e.section_label || key, entries: [] });
    map.get(key).entries.push(e);
  }
  const all = [...map.values()].sort((a, b) => b.entries.length - a.entries.length);

  return all.map((s, i) => ({
    params: { shelf: s.key },
    props: {
      shelf: s,
      n: i + 1,
      siblings: all.map((x, j) => ({ key: x.key, label: x.label, count: x.entries.length, n: j + 1 })),
      total: listings.length,
    },
  }));
}

const { shelf, n, siblings, total } = Astro.props;

// THEME THE HEADER, NEVER THE ROW (specs/DOOR_THEMES_v0.1.md). Everything the theme
// touches is above the list: the glyph, the accent on the heading rule, the standing
// line. Rows below are byte-identical across all thirteen shelves.
const th = themeFor(shelf.key);

// Entries sorted by name so a reader can find one; the shelf's own order is arbitrary.
const rows = [...shelf.entries].sort((a, b) => a.name.localeCompare(b.name));

const stamped = rows.filter((e) => e.last_checked).length;
const freshest = rows.reduce((a, e) => (e.last_checked && e.last_checked > a ? e.last_checked : a), '');
const buried = rows.filter((e) => e.status === 'graveyard').length;

function verb(e) {
  const d = (e.desc || '').replace(/\s+/g, ' ').trim();
  if (!d) return '';
  const cut = d.split(/(?<=[.;])\s/)[0];
  return cut.length > 110 ? cut.slice(0, 107).trimEnd() + '…' : cut;
}

// Two columns of rows on a wide screen, one on a phone — the packing rule from the wall,
// applied to a single shelf. A 2-entry shelf must not stretch across a 1400px page.
const span = rows.length > 24 ? 2 : 1;
---

<BaseLayout
  title={`${shelf.label} — 24K Labs gold-402 index`}
  description={`${rows.length} curated x402 services under ${shelf.label}. Every one live-knocked before listing. Static, free, no key.`}
  bare={true}
>
  <div class="wall" style={`--accent:${th.accent};--tint:${th.tint}`}>

    <header class="wall-mast">
      <div class="wall-mast__row">
        <span class="wall-mast__mark">◆ 24K LABS</span>
        <span class="wall-mast__sub">THE GOLD&#8209;402 INDEX</span>
      </div>
      <div class="wall-mast__rule"></div>

      <!-- Breadcrumb. Plain links, no chrome — how a 1996 reader knew where they were. -->
      <nav class="wall-crumb" aria-label="Breadcrumb">
        <a href="/wall/">Top</a>
        <span>:</span>
        <strong>{shelf.label}</strong>
      </nav>

      <div class={`wall-panel wall-panel--${th.ornament || 'plain'}`}>
      <h1 class={`wall-title${th.serif ? ' wall-title--serif' : ''}${th.mono ? ' wall-title--mono' : ''}${th.doubleRule ? ' wall-title--dbl' : ''}`}>
        <span class="wall-title__n">{String(n).padStart(2, '0')}</span>
        <svg class="wall-glyph" viewBox="0 0 16 16" aria-hidden="true" set:html={th.glyph}></svg>
        {shelf.label}
        <span class="wall-title__c">{rows.length}</span>
      </h1>

      <!-- The standing line: what this shelf is, and what its stamp does and does not
           prove here specifically. The spec calls this one of the three things never to
           cut, and it is the only part of the theme that carries information. -->
      <p class="wall-standing">{th.standing}</p>

      <p class="wall-register">— {th.register} —</p>

      {th.ornament === 'ticker' && <div class="orn-ticker" aria-hidden="true"></div>}
      {th.ornament === 'receipt' && (
        <div class="orn-receipt" aria-hidden="true">
          {rows.slice(0, 3).map((e) => (
            <span><i>{e.name.slice(0, 22)}</i><u></u><b>{e.last_checked ? e.last_checked.slice(5) : '—'}</b></span>
          ))}
          <span class="orn-receipt__tot"><i>TOTAL LISTED</i><u></u><b>{rows.length}</b></span>
        </div>
      )}
      {th.ornament === 'nodes' && (
        <svg class="orn-nodes" viewBox="0 0 220 34" aria-hidden="true">
          <path d="M14 17h44M72 17h44M130 17h44M188 17h18" />
          <circle cx="8" cy="17" r="4" /><circle cx="65" cy="17" r="4" />
          <circle cx="123" cy="17" r="4" /><circle cx="181" cy="17" r="4" />
          <path d="M65 17 44 5M123 17l21 12M181 17l-18-12" />
        </svg>
      )}
      {th.ornament === 'graticule' && <div class="orn-grat" aria-hidden="true"></div>}
      {th.ornament === 'rack' && (
        <div class="orn-rack" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      )}
      {th.ornament === 'prompt' && (
        <p class="orn-prompt" aria-hidden="true"># {rows.length} entries · sorted by name · knock date in the right gutter</p>
      )}
      {th.ornament === 'flap' && (
        <div class="orn-flap" aria-hidden="true">
          {['BASE', 'SOL', 'XRPL', 'EVM', 'MULTI'].map((c) => <b>{c}</b>)}
        </div>
      )}
      {th.ornament === 'card' && <div class="orn-card" aria-hidden="true">GOLD&#8209;402 · {shelf.key.toUpperCase()} · {String(n).padStart(2, '0')}</div>}
      {th.ornament === 'terminal' && (
        <p class="orn-term" aria-hidden="true">scan · {rows.length} targets · last pass {freshest || 'n/a'} · signed by a human</p>
      )}
      {th.ornament === 'dropcap' && (
        <p class="orn-cap" aria-hidden="true"><span>A</span>bove all, a page that teaches has to still be true. We can only prove it still loads.</p>
      )}
      {th.ornament === 'pin' && <div class="orn-pin" aria-hidden="true">◉</div>}
      {th.ornament === 'spread' && (
        <div class="orn-spread" aria-hidden="true">
          {rows.slice(0, 24).map((e) => <i style={`opacity:${e.last_checked ? 0.85 : 0.25}`}></i>)}
        </div>
      )}

      {th.statusStrip && (
        <!-- SECURITY earns a status strip because we hold the numbers already. Three
             chips from real knock receipts — no chart, no decoration, no new data. -->
        <div class="wall-chips">
          <span class="wall-chip"><b>{rows.filter((e) => e.last_checked && e.status !== 'graveyard').length}</b> answered when knocked</span>
          <span class="wall-chip"><b>{rows.filter((e) => e.status === 'graveyard').length}</b> answer nothing</span>
          <span class="wall-chip"><b>{rows.filter((e) => !e.last_checked).length}</b> no receipt on file</span>
        </div>
      )}

      </div>

      <p class="wall-mast__standing wall-mast__standing--nums">
        <strong>{rows.length}</strong> of <strong>{total}</strong> curated services sit on this shelf.
        <strong>{stamped}</strong> carry a dated knock{freshest ? <>; most recent <time>{freshest}</time></> : null}.
        {buried > 0 ? <> <strong>{buried}</strong> currently answer nothing.</> : null}
        A knock is one HTTP request that got an answer — not a delivery test. Read a stamp as
        <em> reachable and speaks the protocol</em>, never as <em>worth the money</em>.
      </p>
    </header>

    <main>
      <ul class="wall-list wall-list--page" style={`--cols:${span}`}>
        {rows.map((e) => (
          <li class="wall-row">
            <a class="wall-row__a" href={`/listing/${e.slug}/`}>{e.name}</a>
            {e.last_checked
              ? <time class="wall-row__d" datetime={e.last_checked}>{e.last_checked.slice(5)}</time>
              : <span class="wall-row__d wall-row__d--none" title="no knock receipt on file">—</span>}
            <span class="wall-row__v">{verb(e)}</span>
          </li>
        ))}
      </ul>
    </main>

    <!-- NEVER A DEAD END. Every sibling shelf, with its count, at the bottom of every page. -->
    <nav class="wall-rail" aria-label="Other shelves">
      <h2 class="wall-h wall-h--rail"><span class="wall-h__t">The rest of the index</span></h2>
      <div class="wall-shape">
        {siblings.map((s) => (
          s.key === shelf.key
            ? <span class="wall-shape__here">
                <span class="wall-shape__n">{String(s.n).padStart(2, '0')}</span>
                <span class="wall-shape__l">{s.label}</span>
                <span class="wall-shape__c">{s.count}</span>
              </span>
            : <a href={`/wall/${s.key}/`}>
                <span class="wall-shape__n">{String(s.n).padStart(2, '0')}</span>
                <span class="wall-shape__l">{s.label}</span>
                <span class="wall-shape__c">{s.count}</span>
              </a>
        ))}
      </div>
    </nav>

    <footer class="wall-foot">
      <div class="wall-mast__rule"></div>
      <p>
        <a href="/wall/">← the whole index</a> · <a href="/verify">verify an endpoint</a> ·
        <a href="/api/directory/search?q=">search, free</a> ·
        <a href="https://github.com/Haustorium12/gold-402">get listed</a>
      </p>
      <p>
        Nothing here is pay&#8209;to&#8209;list. A service earns its spot through a pull request a human
        reads and an endpoint that answers. Reading is never gated — static, free, no key.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .wall { max-width: 1400px; margin: 0 auto; padding: 28px 18px 64px; font-size: 13px; line-height: 1.45; }

  .wall-mast__row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .wall-mast__mark { font-family: var(--mono); font-weight: 700; font-size: 15px; letter-spacing: 0.16em; color: var(--gold); }
  .wall-mast__sub { font-family: var(--mono); font-size: 11px; letter-spacing: 0.3em; color: var(--text-dim); }
  .wall-mast__rule { height: 1px; margin: 10px 0 12px; background: linear-gradient(90deg, var(--gold) 0%, var(--gold-dim) 42%, var(--border) 100%); }

  .wall-crumb { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); margin-bottom: 10px; }
  .wall-crumb a { color: var(--text-muted); text-decoration: none; }
  .wall-crumb a:hover { color: var(--gold-light); }
  .wall-crumb strong { color: var(--text); font-weight: 500; }

  /* Same heading register as the wall: number, letterspaced caps, count, rule to the edge. */
  .wall-title {
    display: flex; align-items: baseline; gap: 11px;
    margin: 0 0 8px; padding-bottom: 6px;
    border-bottom: 1px solid var(--gold-dim);
    font-size: 15px; font-weight: 700; letter-spacing: 0.13em;
    text-transform: uppercase; color: var(--gold);
  }
  .wall-title__n { font-family: var(--mono); font-size: 11px; font-weight: 400; color: var(--gold-dim); letter-spacing: 0; }
  /* The accent lives on the heading rule and nowhere else structural. Gold still carries
     the type — the accent is a supporting voice, never a replacement. */
  .wall-title { border-bottom-color: var(--accent); }
  .wall-title--dbl { border-bottom: 3px double var(--accent); }
  .wall-title--serif { font-family: Georgia, 'Times New Roman', serif; letter-spacing: 0.04em; text-transform: none; font-size: 19px; }
  .wall-title--mono { font-family: var(--mono); letter-spacing: 0.06em; }
  .wall-glyph {
    width: 15px; height: 15px; flex: none;
    fill: none; stroke: var(--accent); stroke-width: 1.3;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .wall-standing {
    margin: 10px 0 0; max-width: 74ch;
    color: var(--text-muted); font-size: 12.5px; line-height: 1.5;
    border-left: 2px solid var(--accent); padding-left: 11px;
  }
  .wall-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .wall-chip {
    font-family: var(--mono); font-size: 10.5px; color: var(--text-muted);
    border: 1px solid var(--border); border-left: 2px solid var(--accent);
    padding: 2px 8px;
  }
  .wall-chip b { color: var(--text); font-variant-numeric: tabular-nums; }
  .wall-mast__standing--nums { margin-top: 14px; }

  .wall-title__c { margin-left: auto; font-family: var(--mono); font-size: 12px; font-weight: 400; color: var(--text-dim); letter-spacing: 0; font-variant-numeric: tabular-nums; }

  .wall-mast__standing { margin: 0 0 20px; max-width: 80ch; color: var(--text-muted); font-size: 12.5px; }
  .wall-mast__standing strong { color: var(--text); font-family: var(--mono); }
  .wall-mast__standing time { font-family: var(--mono); color: var(--gold-light); }
  .wall-mast__standing em { color: var(--text); font-style: italic; }

  /* THE MASTHEAD PANEL — Sean's override, 2026-08-29: more decoration. A bounded block
     with the shelf's tint and corner ticks, the way a ruled frame sits around a column in
     an almanac or a market report. Everything ornamental is INSIDE this panel; the list
     below it is untouched on every shelf. */
  .wall-panel {
    position: relative;
    background: var(--tint, transparent);
    border: 1px solid var(--border);
    padding: 14px 16px 15px;
    margin-bottom: 20px;
  }
  /* Corner ticks. Four 7px hairlines, the registration marks on a printed sheet. */
  .wall-panel::before, .wall-panel::after {
    content: ''; position: absolute; width: 7px; height: 7px; pointer-events: none;
  }
  .wall-panel::before { top: -1px; left: -1px; border-top: 1px solid var(--accent); border-left: 1px solid var(--accent); }
  .wall-panel::after { bottom: -1px; right: -1px; border-bottom: 1px solid var(--accent); border-right: 1px solid var(--accent); }
  .wall-panel .wall-title { margin-top: 0; }

  .wall-register {
    margin: 9px 0 0; font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--text-dim); font-family: var(--mono);
  }

  /* MARKET DATA — the feed rack. Fine horizontal rules, a printed price table. */
  .orn-ticker {
    height: 22px; margin-top: 11px;
    background: repeating-linear-gradient(to bottom, var(--border) 0 1px, transparent 1px 5px);
    border-left: 2px solid var(--accent); opacity: 0.65;
  }

  /* FACILITATORS — the receipt. Leader dots to the figure, like an itemised bill. */
  .orn-receipt { margin-top: 11px; font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); }
  .orn-receipt span { display: flex; align-items: baseline; gap: 4px; line-height: 1.7; }
  .orn-receipt u { flex: 1; border-bottom: 1px dotted var(--border); text-decoration: none; }
  .orn-receipt i { font-style: normal; }
  .orn-receipt b { color: var(--text-muted); font-variant-numeric: tabular-nums; font-weight: 400; }
  .orn-receipt__tot { border-top: 1px solid var(--accent); margin-top: 3px; padding-top: 3px; }
  .orn-receipt__tot i, .orn-receipt__tot b { color: var(--text); }

  /* MCP SERVERS — the node graph. The one shelf where a diagram is the subject. */
  .orn-nodes { display: block; width: 100%; max-width: 240px; height: 34px; margin-top: 10px;
               fill: none; stroke: var(--accent); stroke-width: 1.1; opacity: 0.7; }

  /* ECOSYSTEM · GLOBAL — the survey sheet. A faint coordinate graticule. */
  .orn-grat {
    height: 26px; margin-top: 11px; opacity: 0.5;
    background:
      repeating-linear-gradient(to right, var(--border) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(to bottom, var(--border) 0 1px, transparent 1px 9px);
  }

  /* FRAMEWORKS — the rack elevation. Bounded unit, screw marks, LED pips. */
  .orn-rack { display: flex; gap: 5px; margin-top: 11px; }
  .orn-rack span {
    flex: 1; height: 9px; border: 1px solid var(--border);
    background: linear-gradient(to right, var(--accent) 0 3px, transparent 3px);
    opacity: 0.55;
  }

  /* SDKS · TOOLS — the workbench. The shelf rule written as a code comment. */
  .orn-prompt { margin: 11px 0 0; font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); }
  .orn-prompt::before { content: '$ '; color: var(--accent); }

  /* GLOBAL — the departures board. Split-flap register, no motion. */
  .orn-flap { display: flex; gap: 4px; margin-top: 11px; }
  .orn-flap b {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; font-weight: 500;
    color: var(--text-muted); background: #06060a; border: 1px solid var(--border);
    border-top-color: var(--accent); padding: 3px 6px;
  }

  /* AGGREGATORS — the card catalogue. A typed catalogue-card label. */
  .orn-card {
    display: inline-block; margin-top: 11px; padding: 3px 9px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
    color: var(--text-muted); border: 1px solid var(--accent); opacity: 0.8;
  }

  /* COMMUNITY — the notice board. Pinned paper, very slightly off-square. */
  .orn-pin { margin-top: 9px; color: var(--accent); font-size: 13px; transform: rotate(-4deg); transform-origin: left; }

  /* SECURITY — the audit terminal. A readout line, signed. */
  .orn-term {
    margin: 11px 0 0; padding: 4px 8px;
    font-family: var(--mono); font-size: 10.5px; color: var(--text-muted);
    background: #06060a; border-left: 2px solid var(--accent);
  }
  .orn-term::before { content: '> '; color: var(--accent); }

  /* LEARNING — the primer. The one drop cap on the site. */
  .orn-cap { margin: 11px 0 0; max-width: 62ch; font-family: Georgia, 'Times New Roman', serif;
             font-size: 12.5px; line-height: 1.5; color: var(--text-muted); font-style: italic; }
  .orn-cap span {
    float: left; font-size: 30px; line-height: 0.82; padding: 2px 7px 0 0;
    color: var(--accent); font-style: normal;
  }

  /* APIS — the capability spread. One tick per entry, dim where no receipt exists. */
  .orn-spread { display: flex; gap: 2px; margin-top: 12px; }
  .orn-spread i { flex: 1; height: 10px; background: var(--accent); }

  .wall-list { list-style: none; margin: 0; padding: 0; }
  .wall-list--page { columns: var(--cols, 1); column-gap: 34px; }
  .wall-row { break-inside: avoid; padding: 2px 0; border-bottom: 1px solid transparent; }
  .wall-row:hover { border-bottom-color: var(--border); }
  .wall-row__a { color: var(--text); text-decoration: none; font-weight: 500; }
  .wall-row__a:hover, .wall-row__a:focus-visible { color: var(--gold-light); text-decoration: underline; }
  .wall-row__d { font-family: var(--mono); font-size: 10px; color: var(--text-dim); margin-left: 6px; font-variant-numeric: tabular-nums; }
  .wall-row__d--none { color: #3a3a48; }
  .wall-row__v { display: block; color: var(--text-muted); font-size: 11.5px; line-height: 1.35; margin-bottom: 4px; }

  .wall-rail { margin-top: 40px; padding-top: 4px; }
  .wall-h { display: flex; align-items: baseline; gap: 9px; margin: 0 0 9px; padding-bottom: 5px;
            border-bottom: 1px solid var(--gold-dim); font-size: 12px; font-weight: 700;
            letter-spacing: 0.13em; text-transform: uppercase; color: var(--gold); }
  .wall-shape { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1px 20px; }
  .wall-shape a, .wall-shape__here { display: flex; align-items: baseline; gap: 8px; padding: 2px 0; text-decoration: none; border-bottom: 1px dotted transparent; }
  .wall-shape a:hover, .wall-shape a:focus-visible { border-bottom-color: var(--gold-dim); }
  .wall-shape__here .wall-shape__l { color: var(--text-dim); }
  .wall-shape__here { opacity: 0.55; }
  .wall-shape__n { font-family: var(--mono); font-size: 10px; color: var(--text-dim); }
  .wall-shape__l { color: var(--gold); font-weight: 600; }
  .wall-shape__c { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-variant-numeric: tabular-nums; }

  .wall-foot { margin-top: 34px; color: var(--text-dim); font-size: 11.5px; }
  .wall-foot p { margin: 8px 0; max-width: 82ch; }
  .wall-foot a { color: var(--text-muted); }

  @media (max-width: 900px) {
    .wall { font-size: 14px; padding: 20px 14px 48px; }
    .wall-list--page { columns: 1; }
    .wall-shape { grid-template-columns: 1fr 1fr; }
  }
</style>

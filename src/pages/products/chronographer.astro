---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Chronographer — 24K Labs"
  description="Temporal context for AI agents. 15+ time systems in one request. Pay $0.001 USDC per call. No API key. x402-native."
>

  <!-- HERO -->
  <section class="tl-hero">
    <div class="tl-hero__glow"></div>
    <div class="tl-hero__grid"></div>
    <div class="container">
      <div class="tl-hero__inner">
        <div class="tl-hero__badge">
          <span class="tl-hero__badge-dot"></span>
          Live — x402 Protocol
        </div>
        <h1 class="tl-hero__title">
          <span class="tl-hero__title-small">Introducing Thaddeus Time</span>
          <span class="tl-hero__title-main">The Chronographer</span>
        </h1>
        <p class="tl-hero__tagline">
          Temporal context for AI agents.<br>
          15+ time systems. One request. $0.001 USDC.
        </p>
        <div class="tl-hero__price-strip">
          <div class="tl-price-item">
            <span class="tl-price-val">$0.001</span>
            <span class="tl-price-label">Full context</span>
          </div>
          <div class="tl-price-divider">·</div>
          <div class="tl-price-item">
            <span class="tl-price-val">15+</span>
            <span class="tl-price-label">Time systems</span>
          </div>
          <div class="tl-price-divider">·</div>
          <div class="tl-price-item">
            <span class="tl-price-val">~2ms</span>
            <span class="tl-price-label">Response time</span>
          </div>
          <div class="tl-price-divider">·</div>
          <div class="tl-price-item">
            <span class="tl-price-val">0</span>
            <span class="tl-price-label">API keys</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section tl-problem">
    <div class="container">
      <div class="tl-problem__inner reveal">
        <div class="tl-problem__text">
          <h2 class="tl-section-title">AI agents are temporally blind.</h2>
          <p class="tl-body">
            They don't know what day it is. They don't know the phase of the moon, where they are
            in the market calendar, what astronomical events are approaching, or what the circadian
            window means for the human they're working with.
          </p>
          <p class="tl-body">
            Every agent that needs temporal awareness either hardcodes a date, asks a human,
            or calls a free API that wasn't built for programmatic machine consumption.
          </p>
          <p class="tl-body tl-body--gold">
            The Chronographer fixes this. One x402 request. Instant. No account. No key.
            15 time systems returned in a single JSON object.
          </p>
        </div>
        <div class="tl-problem__code">
          <div class="tl-code-block">
            <div class="tl-code-bar">
              <span class="tl-code-dot" style="background:#ff5f57"></span>
              <span class="tl-code-dot" style="background:#ffbd2e"></span>
              <span class="tl-code-dot" style="background:#28c840"></span>
              <span class="tl-code-label">request</span>
            </div>
            <pre class="tl-code"><code>{`GET https://time.24klabs.ai/time
PAYMENT-SIGNATURE: <signed $0.001 USDC>

→ HTTP 200
{
  "gregorian": {
    "date": "2026-06-04",
    "weekday": "Thursday",
    "day_of_year": 155,
    "week_of_year": 23
  },
  "lunar": {
    "phase_name": "Waxing Crescent",
    "age_days": 7.3,
    "next_full": "2026-06-11",
    "full_moon_name": "Strawberry Moon"
  },
  "solar": {
    "sunrise": "5:32 AM",
    "solar_noon": "12:57 PM",
    "sunset": "8:22 PM",
    "golden_hour_start": "7:26 PM"
  },
  "astrology": {
    "sun_sign": "Gemini",
    "day_ruler": "Jupiter",
    "hour_ruler": "Mercury"
  },
  "market": {
    "session": "US Regular",
    "days_to_quarter_end": 27
  },
  "circadian": {
    "window": "Peak Focus",
    "hours_since_dawn": 6.2
  }
  ... 9 more systems
}`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE 15 SYSTEMS -->
  <section class="section tl-systems" style="background: var(--bg-surface);">
    <div class="container">
      <h2 class="section__title reveal">15 Time Systems. One Request.</h2>
      <p class="section__subtitle reveal">Everything returned in a single JSON object. Cherry-pick what you need with the <code>?systems=</code> param.</p>

      <div class="tl-systems__grid reveal">
        {[
          { name: 'Gregorian',       desc: 'Date, weekday, day/week of year, days to quarter, holidays',  price: '$0.001', tier: 'core' },
          { name: 'Unix',            desc: 'Timestamp, milliseconds, seconds since epoch',                 price: '$0.001', tier: 'core' },
          { name: 'ISO 8601',        desc: 'ISO date, week number, ordinal date',                          price: '$0.001', tier: 'core' },
          { name: 'Julian',          desc: 'Julian Date, Modified Julian Date',                            price: '$0.001', tier: 'core' },
          { name: 'Solar',           desc: 'Sunrise, noon, sunset, golden hour, daylight hours',           price: '$0.001', tier: 'core' },
          { name: 'Lunar',           desc: 'Phase name, age, cycle %, next new/full, moon name',           price: '$0.001', tier: 'core' },
          { name: 'Circadian',       desc: 'Window type (peak/trough/rest), hours since dawn',             price: '$0.001', tier: 'core' },
          { name: 'Sidereal',        desc: 'Local Sidereal Time, Greenwich Sidereal Time',                 price: '$0.001', tier: 'core' },
          { name: 'Wheel of Year',   desc: 'Last/next sabbat, days between, ladder of 8 stations',        price: '$0.001', tier: 'core' },
          { name: 'Astrology',       desc: 'Sun sign, ruling planet, day/hour ruler, element, modality',  price: '$0.001', tier: 'core' },
          { name: 'Vedic',           desc: 'Tithi, nakshatra, yoga, vara, karana (Panchangam)',            price: '$0.001', tier: 'core' },
          { name: 'Market',          desc: 'Active session, days to quarter/year end, earnings season',   price: '$0.001', tier: 'core' },
          { name: 'Biorhythm',       desc: 'Physical/emotional/intellectual cycle % (profile-based)',     price: '$0.001', tier: 'core' },
          { name: 'Solar Terms',     desc: 'Current/next of 24 Chinese solar terms (节气)',                price: '$0.001', tier: 'core' },
          { name: 'Hebrew',          desc: 'Hebrew date, parasha, upcoming holidays',                     price: '$0.001', tier: 'core' },
        ].map(s => (
          <div class="tl-system-card">
            <div class="tl-system-card__name">{s.name}</div>
            <div class="tl-system-card__desc">{s.desc}</div>
            <div class="tl-system-card__price">{s.price}</div>
          </div>
        ))}
      </div>

      <p class="tl-systems__note reveal">
        + Chinese, Persian, Mayan Long Count, Ethiopian, Coptic, Islamic, Julian calendar systems in <code>alternative</code> block.
        Planet positions (Mercury–Saturn with retrograde) when enabled.
      </p>
    </div>
  </section>

  <!-- INTEGRATION -->
  <section class="section">
    <div class="container">
      <h2 class="section__title reveal">Two lines of code.</h2>
      <p class="section__subtitle reveal">x402 handles the payment. You get the data.</p>

      <div class="tl-integration reveal">
        <div class="tl-tabs">
          <button class="tl-tab tl-tab--active" data-tab="python">Python</button>
          <button class="tl-tab" data-tab="curl">curl</button>
          <button class="tl-tab" data-tab="typescript">TypeScript</button>
        </div>

        <div class="tl-code-block tl-code-block--lg">
          <div class="tl-code-bar">
            <span class="tl-code-dot" style="background:#ff5f57"></span>
            <span class="tl-code-dot" style="background:#ffbd2e"></span>
            <span class="tl-code-dot" style="background:#28c840"></span>
            <span class="tl-code-label" id="tab-label">integration.py</span>
          </div>
          <div id="code-python">
            <pre class="tl-code"><code>{`from x402 import x402Client
from x402.mechanisms.evm.exact.register import register_exact_evm_client
from eth_account import Account
import os, requests

# Your Base wallet — the payment is automatic
client = x402Client()
register_exact_evm_client(client, Account.from_key(os.environ["WALLET_KEY"]))

# That's it. The x402 client handles the 402 → pay → retry loop.
from x402.http.clients import x402RequestsClient

with x402RequestsClient(client) as http:
    ctx = http.get("https://time.24klabs.ai/time").json()

print(ctx["lunar"]["phase_name"])   # "Waxing Crescent"
print(ctx["market"]["session"])     # "US Regular"
print(ctx["circadian"]["window"])   # "Peak Focus"`}</code></pre>
          </div>
          <div id="code-curl" style="display:none">
            <pre class="tl-code"><code>{`# First call — get the 402 with price
curl -I https://time.24klabs.ai/time
# → HTTP 402
# → PAYMENT-REQUIRED: <base64 payment terms>

# Sign and pay with your wallet, then retry with the signature
curl https://time.24klabs.ai/time \\
  -H "PAYMENT-SIGNATURE: <signed payload>" | jq .lunar`}</code></pre>
          </div>
          <div id="code-typescript" style="display:none">
            <pre class="tl-code"><code>{`import { x402Client } from "@x402/core/client";
import { ExactEvmScheme } from "@x402/evm/exact/client";
import { privateKeyToAccount } from "viem/accounts";

const signer = privateKeyToAccount(process.env.WALLET_KEY as \`0x\${string}\`);
const client = new x402Client();
client.register("eip155:*", new ExactEvmScheme(signer));

// Fetch with auto-payment
const { wrapFetchWithPayment } = await import("@x402/core/client");
const pay = wrapFetchWithPayment(fetch, client);

const ctx = await pay("https://time.24klabs.ai/time").then(r => r.json());
console.log(ctx.lunar.phase_name);  // "Waxing Crescent"`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTELLIGENCE TIER -->
  <section class="section tl-intelligence" style="background: var(--bg-surface);">
    <div class="container">
      <div class="tl-intelligence__inner reveal">
        <div>
          <h2 class="tl-section-title">Ask it anything.</h2>
          <p class="tl-body">
            Beyond raw data, Thaddeus Time interprets the moment. Powered by Claude Haiku,
            the <code>/summary</code> and <code>/ask</code> endpoints give you the
            Thaddeus Time's voice — ancient knowing, precise, never verbose.
          </p>
          <div class="tl-intelligence__pricing">
            <div class="tl-intel-tier">
              <span class="tl-intel-tier__endpoint">/summary</span>
              <span class="tl-intel-tier__price">$0.05</span>
              <span class="tl-intel-tier__desc">Synthesized interpretation of the current moment</span>
            </div>
            <div class="tl-intel-tier">
              <span class="tl-intel-tier__endpoint">/ask</span>
              <span class="tl-intel-tier__price">$0.05</span>
              <span class="tl-intel-tier__desc">Ask a temporal question, get a precise answer</span>
            </div>
          </div>
        </div>
        <div class="tl-intelligence__example">
          <div class="tl-code-block">
            <div class="tl-code-bar">
              <span class="tl-code-dot" style="background:#ff5f57"></span>
              <span class="tl-code-dot" style="background:#ffbd2e"></span>
              <span class="tl-code-dot" style="background:#28c840"></span>
              <span class="tl-code-label">ask</span>
            </div>
            <pre class="tl-code"><code>{`POST /ask
{"question": "What time system is most relevant to grief work right now?"}

→ "You are in the dark half of the Wheel, three days past
   Samhain — the traditional threshold between worlds, when
   the veil between living and dead is considered thin. The
   moon is waning gibbous, moving toward the dark: a natural
   time for release rather than acquisition. The circadian
   window is late afternoon, the liminal hour. If grief needs
   a frame, this one fits: the world itself is practicing
   letting go right now."

                        — Thaddeus Time, $0.05 USDC`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="tl-cta reveal">
        <div class="tl-cta__badge">Live Now</div>
        <h2 class="tl-cta__title">Start using The Chronographer.</h2>
        <p class="tl-cta__desc">
          No account. No API key. Send USDC, get time.<br>
          Works with any x402-compatible client.
        </p>
        <div class="tl-cta__links">
          <a href="https://time.24klabs.ai/time" target="_blank" rel="noopener" class="btn btn--primary">Try it now →</a>
          <a href="/developers/quickstart" class="btn btn--outline">Quickstart Guide →</a>
        </div>
        <p class="tl-cta__sub">
          Built by <a href="https://24klabs.ai" class="tl-link">24K Labs</a> · Powered by x402 · USDC on Base L2
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── Hero ─── */
  .tl-hero {
    position: relative;
    padding: 140px 0 100px;
    text-align: center;
    overflow: hidden;
  }

  .tl-hero__glow {
    position: absolute;
    top: -150px; left: 50%;
    transform: translateX(-50%);
    width: 900px; height: 700px;
    background: radial-gradient(ellipse, rgba(212,175,55,0.12) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .tl-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(212,175,55,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,175,55,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black, transparent);
  }

  .tl-hero__inner { position: relative; z-index: 1; }

  .tl-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 32px;
  }

  .tl-hero__badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .tl-hero__title { margin-bottom: 24px; }

  .tl-hero__title-small {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .tl-hero__title-main {
    display: block;
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    background: linear-gradient(135deg, #fff 0%, var(--gold) 50%, #c8a84b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tl-hero__tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 48px;
  }

  .tl-hero__price-strip {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 20px 40px;
    background: rgba(212,175,55,0.04);
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tl-price-item { text-align: center; }

  .tl-price-val {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .tl-price-label {
    display: block;
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 2px;
  }

  .tl-price-divider { color: var(--border); font-size: 1.2rem; }

  /* ─── Section typography ─── */
  .tl-section-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .tl-body {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 16px;
    max-width: 520px;
  }

  .tl-body--gold { color: var(--text); font-weight: 500; }

  /* ─── Problem section ─── */
  .tl-problem__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  /* ─── Code blocks ─── */
  .tl-code-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .tl-code-block--lg { border-radius: var(--radius-lg); }

  .tl-code-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .tl-code-dot { width: 10px; height: 10px; border-radius: 50%; }

  .tl-code-label {
    margin-left: 8px;
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--mono);
  }

  .tl-code {
    padding: 20px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--text-muted);
    white-space: pre;
  }

  /* ─── Systems grid ─── */
  .tl-systems__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }

  .tl-system-card {
    padding: 16px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }

  .tl-system-card:hover { border-color: var(--gold-dim); }

  .tl-system-card__name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .tl-system-card__desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.5;
    margin-bottom: 10px;
  }

  .tl-system-card__price {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    font-family: var(--mono);
  }

  .tl-systems__note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: 8px;
  }

  /* ─── Integration tabs ─── */
  .tl-integration { max-width: 800px; margin: 0 auto; }

  .tl-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .tl-tab {
    padding: 8px 20px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-dim);
    font-size: 0.85rem;
    font-family: var(--mono);
    cursor: pointer;
    transition: all 0.2s;
  }

  .tl-tab--active,
  .tl-tab:hover {
    border-color: var(--gold-dim);
    color: var(--gold);
    background: rgba(212,175,55,0.05);
  }

  /* ─── Intelligence tier ─── */
  .tl-intelligence__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .tl-intelligence__pricing { margin-top: 28px; }

  .tl-intel-tier {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .tl-intel-tier:last-child { border-bottom: none; }

  .tl-intel-tier__endpoint {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--gold);
    font-weight: 600;
  }

  .tl-intel-tier__price {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .tl-intel-tier__desc {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* ─── CTA ─── */
  .tl-cta {
    text-align: center;
    padding: 80px 40px;
    background: rgba(212,175,55,0.03);
    border: 1px solid var(--gold-dim);
    border-radius: var(--radius-lg);
  }

  .tl-cta__badge {
    display: inline-block;
    padding: 4px 14px;
    background: rgba(212,175,55,0.1);
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
  }

  .tl-cta__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .tl-cta__desc {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 32px;
  }

  .tl-cta__links {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .tl-cta__sub {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .tl-link { color: var(--gold); text-decoration: none; }
  .tl-link:hover { text-decoration: underline; }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .tl-hero { padding: 100px 0 60px; }
    .tl-hero__price-strip { padding: 16px 24px; gap: 16px; }
    .tl-problem__inner { grid-template-columns: 1fr; }
    .tl-intelligence__inner { grid-template-columns: 1fr; }
    .tl-systems__grid { grid-template-columns: 1fr 1fr; }
    .tl-cta { padding: 48px 24px; }
  }

  @media (max-width: 480px) {
    .tl-systems__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Tab switcher
  const tabs = document.querySelectorAll('.tl-tab');
  const panels: Record<string, string> = {
    python: 'integration.py',
    curl: 'shell',
    typescript: 'integration.ts',
  };

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab!;
      tabs.forEach(t => t.classList.remove('tl-tab--active'));
      tab.classList.add('tl-tab--active');

      ['python', 'curl', 'typescript'].forEach(id => {
        const el = document.getElementById(`code-${id}`);
        if (el) el.style.display = id === target ? 'block' : 'none';
      });

      const label = document.getElementById('tab-label');
      if (label) label.textContent = panels[target] || target;
    });
  });
</script>

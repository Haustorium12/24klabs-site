---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listings } from '../lib/listings.js';

// Landing page. 24klabs.ai is the Gold-402 Directory — the list is the product. The full
// directory app (search, filters, cards) lives at /directory; this page explains what the
// directory is and sends people into it. Counts are read live from the same editorial list.
const totalEditorial = listings.length;
const sections = [...new Set(listings.map((e) => e.section_label))];
---

<BaseLayout
  title="24K Labs — The Gold-402 Directory for the x402 Ecosystem"
  description="A curated directory of x402 services — each one on the list on purpose, with the health, uptime, and independent trust grades from across the ecosystem gathered in one place."
>

  <!-- HERO -->
  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container">
      <span class="page-header__badge"><span class="live-dot"></span>The x402 Trust Layer</span>
      <h1 class="page-header__title">The curated directory for the <span class="text-gold">x402 ecosystem</span></h1>
      <p class="page-header__desc">
        Every service on the Gold-402 list is one we put there on purpose — with the independent
        health, uptime, and trust grades from across the ecosystem gathered in one place. Don't let
        your agents trade in the dark.
      </p>
      <div style="margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/directory" class="btn btn--primary btn--lg">Browse the Directory</a>
        <a href="/gold-402" class="btn btn--outline btn--lg">Get Listed ↗</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="grid-3">
        <div class="card reveal" style="text-align: center;">
          <div class="text-gold" style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em;">{totalEditorial}</div>
          <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 6px;">Curated entries</div>
        </div>
        <div class="card reveal" style="text-align: center;">
          <div class="text-gold" style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em;">{sections.length}</div>
          <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 6px;">Categories</div>
        </div>
        <div class="card reveal" style="text-align: center;">
          <div class="text-gold" style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em;">Base L2</div>
          <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 6px;">Primary network</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section class="section">
    <div class="container">
      <div class="prose reveal">
        <h2>What this is</h2>
        <p>
          24K Labs runs the Gold-402 Directory — a curated map of the x402 ecosystem. The x402
          protocol lets an AI agent pay for a service in USDC and get its result with no account
          and no API key. The catch: the endpoints are scattered, and plenty are dead, mislabeled,
          or vaporware. This directory is the layer that sorts the real from the noise.
        </p>
        <p>
          Being on the list is the whole point. Each entry gets its own page — our note on the
          service, the endpoint, and any independent trust grades we can pull in from raters across
          the ecosystem. Nothing here is pay-to-list.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" style="background: var(--bg-surface);">
    <div class="container">
      <h2 class="section__title reveal">How the directory works</h2>
      <p class="section__subtitle reveal">A list you can trust, and the grades to back it up.</p>
      <div class="grid-3">
        <div class="card reveal">
          <div class="text-gold" style="font-weight: 800; font-size: 1.5rem; margin-bottom: 8px;">1</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 10px;">Curated, not scraped</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">A service earns its spot through a submission, not an algorithm. If it isn't real, it doesn't go on the list.</p>
        </div>
        <div class="card reveal">
          <div class="text-gold" style="font-weight: 800; font-size: 1.5rem; margin-bottom: 8px;">2</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 10px;">Grades from the ecosystem</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">Where independent raters (like fuchss) publish a live grade for an endpoint, we surface it right on the listing.</p>
        </div>
        <div class="card reveal">
          <div class="text-gold" style="font-weight: 800; font-size: 1.5rem; margin-bottom: 8px;">3</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 10px;">Built for agents</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">The Verify API returns our verdict plus aggregated rater grades for any resource in one call — x402-gated at $0.001, no key.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section">
    <div class="container">
      <h2 class="section__title reveal">The human layer of the x402 economy</h2>
      <p class="section__subtitle reveal">
        x402 is backed by the Linux Foundation with 50+ member organizations including Coinbase,
        Cloudflare, Stripe, Visa, and AWS. The protocol moves the money; the directory tells you
        which endpoints are worth paying.
      </p>
      <div style="text-align: center; margin-top: 32px;">
        <a href="/products/x402" class="btn btn--outline">Learn how x402 works →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="coming-soon reveal">
        <h2 class="coming-soon__title">Find a service, or get on the list</h2>
        <p class="coming-soon__desc">
          Browse the directory, or open a pull request to add your x402 service. If it's real, it gets a spot.
        </p>
        <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="/directory" class="btn btn--primary">Browse the Directory</a>
          <a href="/gold-402" class="btn btn--outline">Get Listed ↗</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .live-dot {
    display: inline-block;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--gold); margin-right: 7px;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Gold-402 Directory — 24K Labs" description="The open x402 service directory. 40,000+ verified endpoints. Curated by 24K Labs.">

  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container">
      <span class="page-header__badge">
        <span class="live-dot"></span>Live Directory
      </span>
      <h1 class="page-header__title">Gold-402 <span class="text-gold">Directory</span></h1>
      <p class="page-header__desc">
        The open x402 service directory. Verified endpoints. Curated by 24K Labs.
      </p>
      <div class="stats-bar" id="stats-bar">
        <div class="stat"><span class="stat-value" id="stat-total">—</span><span class="stat-label">Services</span></div>
        <div class="stat"><span class="stat-value" id="stat-networks">8</span><span class="stat-label">Networks</span></div>
        <div class="stat"><span class="stat-value" id="stat-verified">—</span><span class="stat-label">Verified</span></div>
        <div class="stat"><span class="stat-value" id="stat-updated">—</span><span class="stat-label">Updated</span></div>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="section--sm" id="featured-section" style="display:none">
    <div class="container">
      <div class="section-label">Featured — Top by Activity</div>
      <div class="grid-3" id="featured-grid"></div>
    </div>
  </section>

  <!-- Controls -->
  <section class="section--sm controls-section">
    <div class="container">
      <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input class="search-input" id="search" type="text" placeholder="Search services, tools, facilitators..." />
        <span class="search-clear" id="search-clear" style="display:none">✕</span>
      </div>

      <div class="filter-group">
        <div class="filter-label">Type</div>
        <div class="filter-pills" id="type-pills">
          <button class="pill active" data-value="all">All</button>
          <button class="pill" data-value="API / Service">API / Service</button>
          <button class="pill" data-value="Facilitator">Facilitator</button>
          <button class="pill" data-value="SDK / Library">SDK / Library</button>
          <button class="pill" data-value="MCP Server">MCP Server</button>
          <button class="pill" data-value="Tool">Tool</button>
          <button class="pill" data-value="Wallet">Wallet</button>
          <button class="pill" data-value="Directory / Aggregator">Directory</button>
          <button class="pill" data-value="Learning Resource">Learning</button>
        </div>
      </div>

      <div class="filter-group">
        <div class="filter-label">Domain</div>
        <div class="filter-pills" id="domain-pills">
          <button class="pill active" data-value="all">All</button>
          <button class="pill" data-value="AI">AI</button>
          <button class="pill" data-value="Developer Tools">Dev Tools</button>
          <button class="pill" data-value="Agent / Automation">Agents</button>
          <button class="pill" data-value="Infrastructure">Infrastructure</button>
          <button class="pill" data-value="Security">Security</button>
          <button class="pill" data-value="Finance / DeFi">Finance</button>
          <button class="pill" data-value="Analytics / Monitoring">Analytics</button>
          <button class="pill" data-value="Data">Data</button>
          <button class="pill" data-value="Identity">Identity</button>
          <button class="pill" data-value="Payments / Commerce">Payments</button>
          <button class="pill" data-value="Compliance / Legal">Compliance</button>
          <button class="pill" data-value="Storage">Storage</button>
          <button class="pill" data-value="NFT">NFT</button>
          <button class="pill" data-value="Gaming">Gaming</button>
          <button class="pill" data-value="Media">Media</button>
          <button class="pill" data-value="Testing / Mocking">Testing</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Results bar -->
  <div class="results-bar container">
    <span class="results-count">Showing <strong id="showing-count">—</strong> of <strong id="total-count">—</strong> services</span>
    <label class="verified-toggle">
      <input type="checkbox" id="verified-only" />
      <span class="toggle-track"><span class="toggle-thumb"></span></span>
      <span class="toggle-label">Verified only</span>
    </label>
  </div>

  <!-- Loading state -->
  <div class="container" id="loading-state">
    <div class="loading-msg">
      <div class="loading-spinner"></div>
      <span>Loading Gold-402 directory...</span>
    </div>
  </div>

  <!-- Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-3" id="services-grid"></div>
      <div id="empty-state" class="empty-state" style="display:none">
        <p>No services match your filters.</p>
        <button class="btn btn--outline" id="clear-filters">Clear filters</button>
      </div>
      <div class="pagination" id="pagination" style="display:none">
        <button class="btn btn--outline btn--sm" id="prev-page">← Previous</button>
        <span class="page-info" id="page-info"></span>
        <button class="btn btn--outline btn--sm" id="next-page">Next →</button>
      </div>
    </div>
  </section>

  <!-- Submit CTA -->
  <section class="section--sm">
    <div class="container">
      <div class="directory-cta reveal">
        <p>Building on x402? Get listed on Gold-402.</p>
        <a href="https://github.com/Haustorium12/gold-402/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="btn btn--outline">Submit your service &#8599;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .live-dot {
    display: inline-block; width: 7px; height: 7px;
    border-radius: 50%; background: var(--gold);
    margin-right: 6px; animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  .stats-bar {
    display: flex; justify-content: center; gap: 0;
    border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; max-width: 560px; margin: 32px auto 0;
  }
  .stat {
    flex: 1; padding: 14px 16px; text-align: center;
    border-right: 1px solid var(--border);
  }
  .stat:last-child { border-right: none; }
  .stat-value { display: block; font-size: 1.3rem; font-weight: 800; color: var(--gold); letter-spacing: -0.02em; }
  .stat-label { display: block; font-size: 0.68rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }

  .section-label {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-dim); margin-bottom: 20px;
  }

  .controls-section { padding: 20px 0; }

  .search-wrap {
    position: relative; max-width: 600px; margin: 0 auto 24px;
  }
  .search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: var(--text-dim); font-size: 18px; pointer-events: none;
  }
  .search-input {
    width: 100%; padding: 11px 40px 11px 42px;
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); color: var(--text);
    font-size: 0.9rem; font-family: var(--font); transition: border-color 0.2s;
  }
  .search-input:focus { outline: none; border-color: var(--gold-dim); }
  .search-input::placeholder { color: var(--text-dim); }
  .search-clear {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    color: var(--text-dim); cursor: pointer; font-size: 14px;
  }
  .search-clear:hover { color: var(--text); }

  .filter-group { margin-bottom: 16px; }
  .filter-label {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-dim);
    margin-bottom: 8px; text-align: center;
  }
  .filter-pills { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }

  .pill {
    padding: 5px 14px; border-radius: 100px;
    border: 1px solid var(--border); background: transparent;
    color: var(--text-muted); font-size: 0.78rem; font-weight: 500;
    cursor: pointer; font-family: var(--font); transition: all 0.2s; white-space: nowrap;
  }
  .pill:hover { border-color: var(--gold-dim); color: var(--gold); }
  .pill.active { border-color: var(--gold); background: rgba(212,175,55,0.1); color: var(--gold); font-weight: 600; }

  .results-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 24px; margin-bottom: 8px;
  }
  .results-count { font-size: 0.82rem; color: var(--text-dim); }
  .results-count strong { color: var(--gold); }

  .verified-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .verified-toggle input { display: none; }
  .toggle-track {
    width: 36px; height: 20px; border-radius: 100px;
    background: var(--border); transition: background 0.2s;
    position: relative; display: inline-block;
  }
  .toggle-thumb {
    position: absolute; top: 3px; left: 3px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--text-dim); transition: all 0.2s;
  }
  .verified-toggle input:checked ~ .toggle-track { background: var(--gold-dim); }
  .verified-toggle input:checked ~ .toggle-track .toggle-thumb { left: 19px; background: var(--gold); }
  .toggle-label { font-size: 0.78rem; color: var(--text-muted); }

  .loading-state, #loading-state { padding: 60px 0; }
  .loading-msg {
    display: flex; align-items: center; justify-content: center;
    gap: 12px; color: var(--text-dim); font-size: 0.9rem;
  }
  .loading-spinner {
    width: 18px; height: 18px; border-radius: 50%;
    border: 2px solid var(--border); border-top-color: var(--gold);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .service-card {
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
    display: flex; flex-direction: column; gap: 10px;
    transition: all 0.25s; text-decoration: none; color: var(--text);
    position: relative;
  }
  .service-card:hover {
    border-color: var(--gold-dim); transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3); color: var(--text);
  }
  .service-card.is-24k { border-color: var(--gold-dim); }
  .service-card.is-24k::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(212,175,55,0.04) 0%, transparent 60%);
    border-radius: var(--radius); pointer-events: none;
  }

  .card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .card-name { font-size: 0.95rem; font-weight: 700; }
  .is-24k .card-name { color: var(--gold); }

  .card-badges { display: flex; gap: 4px; flex-wrap: wrap; }
  .badge {
    padding: 2px 8px; border-radius: 100px;
    font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
  }
  .badge-type { background: rgba(124,109,240,0.12); color: #9d8ff5; border: 1px solid rgba(124,109,240,0.2); }
  .badge-verified { background: rgba(78,205,196,0.1); color: #4ecdc4; border: 1px solid rgba(78,205,196,0.2); }
  .badge-24k { background: rgba(212,175,55,0.1); color: var(--gold); border: 1px solid rgba(212,175,55,0.2); }
  .badge-domain {
    background: rgba(255,255,255,0.04); color: var(--text-dim);
    border: 1px solid var(--border);
  }

  .card-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; flex: 1; }

  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: auto; padding-top: 10px; border-top: 1px solid var(--border);
  }
  .card-price { font-size: 0.8rem; font-weight: 700; color: var(--gold); }
  .card-meta { display: flex; gap: 10px; align-items: center; }
  .card-network { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; }
  .card-activity { font-size: 0.7rem; color: var(--text-dim); }
  .card-link { font-size: 0.72rem; color: var(--gold-dim); transition: color 0.2s; }
  .service-card:hover .card-link { color: var(--gold); }

  .empty-state { text-align: center; padding: 60px 0; color: var(--text-dim); }
  .empty-state p { margin-bottom: 20px; }

  .pagination {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin-top: 48px;
  }
  .page-info { font-size: 0.85rem; color: var(--text-muted); }

  .directory-cta { text-align: center; padding: 48px 24px; }
  .directory-cta p { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 20px; }

  @media (max-width: 768px) {
    .stats-bar { max-width: 100%; }
    .stat { padding: 10px 8px; }
    .stat-value { font-size: 1rem; }
  }
</style>

<script>
const DATA_URL = 'https://raw.githubusercontent.com/Haustorium12/gold-402/main/directory/services.json';
const PAGE_SIZE = 20;
const IS_24K_IDS = ['24klabs', '24klabs-code-review', '24klabs-api'];

let allServices = [];
let filtered = [];
let currentPage = 1;
let activeType = 'all';
let activeDomain = 'all';
let verifiedOnly = false;
let searchQuery = '';

function formatPrice(min, max) {
  if (min == null && max == null) return null;
  if (min != null && max != null && min !== max) {
    return '$' + formatNum(min) + '–$' + formatNum(max);
  }
  if (min != null) return '$' + formatNum(min);
  return '$' + formatNum(max);
}

function formatNum(n) {
  if (n < 0.01) return n.toFixed(4).replace(/\.?0+$/, '');
  if (n < 1) return n.toFixed(3).replace(/\.?0+$/, '');
  if (n < 100) return n.toFixed(2).replace(/\.?0+$/, '');
  return Math.round(n).toLocaleString();
}

function formatActivity(calls, payers) {
  if (!calls && !payers) return null;
  if (payers) return payers.toLocaleString() + ' payers/mo';
  return calls.toLocaleString() + ' calls/mo';
}

function is24k(s) {
  return s.website_url && s.website_url.includes('24klabs.ai');
}

function buildCard(s, featured) {
  const price = formatPrice(s.price_min, s.price_max);
  const activity = formatActivity(s.quality_calls_30d, s.quality_payers_30d);
  const tags = (s.domain_tags || []).slice(0, 2);
  const twentyk = is24k(s);

  return `
    <a href="${s.website_url || '#'}" target="_blank" rel="noopener noreferrer"
       class="service-card${twentyk ? ' is-24k' : ''}${featured ? ' reveal' : ' reveal'}">
      <div class="card-header">
        <div class="card-name">${s.name || 'Unnamed Service'}</div>
        <div class="card-badges">
          ${s.verified ? '<span class="badge badge-verified">✓ Verified</span>' : ''}
          ${twentyk ? '<span class="badge badge-24k">24K Labs</span>' : ''}
        </div>
      </div>
      <div class="card-badges">
        <span class="badge badge-type">${s.type || 'Service'}</span>
        ${tags.map(t => `<span class="badge badge-domain">${t}</span>`).join('')}
      </div>
      <div class="card-desc">${s.short_desc || 'x402-enabled service.'}</div>
      <div class="card-footer">
        <span class="card-price">${price || ''}</span>
        <div class="card-meta">
          ${activity ? `<span class="card-activity">${activity}</span>` : ''}
          <span class="card-network">${s.network || 'Base'}</span>
        </div>
        <span class="card-link">Visit →</span>
      </div>
    </a>
  `;
}

function applyFilters() {
  const q = searchQuery.toLowerCase();
  filtered = allServices.filter(s => {
    if (activeType !== 'all' && s.type !== activeType) return false;
    if (activeDomain !== 'all' && !(s.domain_tags || []).includes(activeDomain)) return false;
    if (verifiedOnly && !s.verified) return false;
    if (q) {
      const haystack = [s.name, s.short_desc, ...(s.domain_tags || [])].join(' ').toLowerCase();
      if (!haystack.includes(q)) return false;
    }
    return true;
  });
  currentPage = 1;
  render();
}

function render() {
  const grid = document.getElementById('services-grid');
  const empty = document.getElementById('empty-state');
  const pagination = document.getElementById('pagination');
  const showing = document.getElementById('showing-count');
  const total = document.getElementById('total-count');

  total.textContent = filtered.length.toLocaleString();

  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    pagination.style.display = 'none';
    showing.textContent = '0';
    return;
  }

  empty.style.display = 'none';

  const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
  const start = (currentPage - 1) * PAGE_SIZE;
  const page = filtered.slice(start, start + PAGE_SIZE);

  showing.textContent = page.length.toLocaleString();
  grid.innerHTML = page.map(s => buildCard(s, false)).join('');

  if (totalPages > 1) {
    pagination.style.display = 'flex';
    document.getElementById('page-info').textContent = `Page ${currentPage} of ${totalPages.toLocaleString()}`;
    document.getElementById('prev-page').disabled = currentPage === 1;
    document.getElementById('next-page').disabled = currentPage === totalPages;
  } else {
    pagination.style.display = 'none';
  }

  triggerReveal();
}

function triggerReveal() {
  requestAnimationFrame(() => {
    document.querySelectorAll('.reveal:not(.visible)').forEach((el, i) => {
      setTimeout(() => el.classList.add('visible'), i * 30);
    });
  });
}

async function init() {
  try {
    const res = await fetch(DATA_URL);
    const data = await res.json();
    allServices = data.services || [];

    document.getElementById('loading-state').style.display = 'none';
    document.getElementById('stat-total').textContent = allServices.length.toLocaleString();

    const verifiedCount = allServices.filter(s => s.verified).length;
    document.getElementById('stat-verified').textContent = verifiedCount > 0 ? verifiedCount.toLocaleString() : '—';

    if (data.generated_at) {
      const d = new Date(data.generated_at);
      document.getElementById('stat-updated').textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    const featured = allServices
      .filter(s => s.quality_payers_30d > 0)
      .sort((a, b) => b.quality_payers_30d - a.quality_payers_30d)
      .slice(0, 6);

    if (featured.length > 0) {
      document.getElementById('featured-section').style.display = 'block';
      document.getElementById('featured-grid').innerHTML = featured.map(s => buildCard(s, true)).join('');
    }

    filtered = [...allServices];
    render();
  } catch (e) {
    document.getElementById('loading-state').innerHTML = '<div class="loading-msg">Failed to load directory. <a href="https://github.com/Haustorium12/gold-402" target="_blank">View on GitHub →</a></div>';
  }
}

document.getElementById('search').addEventListener('input', e => {
  searchQuery = e.target.value;
  document.getElementById('search-clear').style.display = searchQuery ? 'block' : 'none';
  applyFilters();
});

document.getElementById('search-clear').addEventListener('click', () => {
  document.getElementById('search').value = '';
  searchQuery = '';
  document.getElementById('search-clear').style.display = 'none';
  applyFilters();
});

document.getElementById('type-pills').addEventListener('click', e => {
  const pill = e.target.closest('.pill');
  if (!pill) return;
  document.querySelectorAll('#type-pills .pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  activeType = pill.dataset.value;
  applyFilters();
});

document.getElementById('domain-pills').addEventListener('click', e => {
  const pill = e.target.closest('.pill');
  if (!pill) return;
  document.querySelectorAll('#domain-pills .pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  activeDomain = pill.dataset.value;
  applyFilters();
});

document.getElementById('verified-only').addEventListener('change', e => {
  verifiedOnly = e.target.checked;
  applyFilters();
});

document.getElementById('prev-page').addEventListener('click', () => {
  if (currentPage > 1) { currentPage--; render(); window.scrollTo(0, 0); }
});

document.getElementById('next-page').addEventListener('click', () => {
  const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
  if (currentPage < totalPages) { currentPage++; render(); window.scrollTo(0, 0); }
});

document.getElementById('clear-filters').addEventListener('click', () => {
  searchQuery = '';
  activeType = 'all';
  activeDomain = 'all';
  verifiedOnly = false;
  document.getElementById('search').value = '';
  document.getElementById('verified-only').checked = false;
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.pill[data-value="all"]').forEach(p => p.classList.add('active'));
  applyFilters();
});

init();
</script>

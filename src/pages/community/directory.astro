---
import BaseLayout from '../../layouts/BaseLayout.astro';
import editorialRaw from '../../data/editorial.json';

// Build section list for filter
const sections = [...new Set(editorialRaw.map(e => e.section_label))];
const totalEditorial = editorialRaw.length;
const FULL_CATALOG_COUNT = '29,800+';
const EDITORIAL_JSON = JSON.stringify(editorialRaw);
---

<BaseLayout title="Gold-402 Directory — 24K Labs" description="The curated x402 service directory. 314 verified entries hand-picked by 24K Labs.">

  <!-- HEADER -->
  <section class="dir-header">
    <div class="dir-header__glow"></div>
    <div class="container">
      <div class="dir-header__top">
        <div class="dir-header__badge">
          <span class="live-dot"></span>Editorial Directory
        </div>
        <h1 class="dir-header__title">Gold-402 <span class="text-gold">Directory</span></h1>
        <p class="dir-header__desc">
          {totalEditorial} hand-picked x402 services, verified and annotated by 24K Labs.
          Not a scrape. Not a list. A standard.
        </p>
      </div>

      <!-- Stats strip -->
      <div class="dir-stats-strip">
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">◈</div>
          <div>
            <span class="dir-stat-card__value">{totalEditorial}</span>
            <span class="dir-stat-card__label">Curated Entries</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">◉</div>
          <div>
            <span class="dir-stat-card__value">{sections.length}</span>
            <span class="dir-stat-card__label">Categories</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">⬡</div>
          <div>
            <span class="dir-stat-card__value">Base L2</span>
            <span class="dir-stat-card__label">Primary Network</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card dir-stat-card--action">
          <a href="https://github.com/Haustorium12/gold-402/blob/main/CONTRIBUTING.md"
             target="_blank" rel="noopener" class="btn btn--gold btn--sm">
            Get Listed ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- APP -->
  <div class="dir-app container">

    <!-- SIDEBAR -->
    <aside class="dir-sidebar">

      <div class="dir-search-wrap">
        <span class="dir-search-icon">⌕</span>
        <input class="dir-search" id="search" type="text" placeholder="Search entries..." />
        <span class="dir-search-clear" id="search-clear" style="display:none">✕</span>
      </div>

      <div class="dir-filter-section">
        <div class="dir-filter-section__header">
          <span class="dir-filter-section__line"></span>
          <span class="dir-filter-section__label">Category</span>
          <span class="dir-filter-section__line"></span>
        </div>
        <div class="dir-filter__list" id="section-pills">
          <button class="dir-pill active" data-value="all">All Categories</button>
          {sections.map(s => (
            <button class="dir-pill" data-value={s}>{s}</button>
          ))}
        </div>
      </div>

      <div class="dir-filter-section">
        <div class="dir-filter-section__header">
          <span class="dir-filter-section__line"></span>
          <span class="dir-filter-section__label">Options</span>
          <span class="dir-filter-section__line"></span>
        </div>
        <label class="dir-toggle">
          <input type="checkbox" id="verified-only" />
          <span class="dir-toggle__track"><span class="dir-toggle__thumb"></span></span>
          <span class="dir-toggle__label">24K Verified only</span>
        </label>
      </div>

      <button class="dir-clear" id="clear-filters">↺ Reset filters</button>

    </aside>

    <!-- MAIN -->
    <main class="dir-main">

      <!-- Results bar -->
      <div class="dir-results-bar">
        <div class="dir-results-left">
          <span class="dir-results-count">
            <strong id="showing-count">—</strong> of <strong id="total-count">—</strong> entries
          </span>
          <span class="dir-results-tag" id="results-label"></span>
        </div>
        <div class="dir-results-right">
          <span class="dir-results-hint">Curated by 24K Labs</span>
        </div>
      </div>

      <!-- Grid -->
      <div class="dir-grid" id="services-grid"></div>

      <!-- Empty -->
      <div id="empty-state" class="dir-empty" style="display:none">
        <div class="dir-empty__icon">◈</div>
        <p>No entries match your filters.</p>
        <button class="btn btn--outline btn--sm" id="clear-filters-2">Reset filters</button>
      </div>

      <!-- Pagination -->
      <div class="dir-pagination" id="pagination" style="display:none">
        <button class="btn btn--outline btn--sm" id="prev-page">← Prev</button>
        <span class="dir-page-info" id="page-info"></span>
        <button class="btn btn--outline btn--sm" id="next-page">Next →</button>
      </div>

      <!-- PAYWALL -->
      <div class="dir-paywall" id="paywall">
        <div class="dir-paywall__inner">
          <div class="dir-paywall__left">
            <div class="dir-paywall__eyebrow">Full Catalog</div>
            <div class="dir-paywall__count">{FULL_CATALOG_COUNT}</div>
            <div class="dir-paywall__label">x402 services indexed</div>
            <p class="dir-paywall__desc">
              Every endpoint auto-discovered from the CDP Bazaar and Agentic.market.
              Raw, unfiltered, machine-queryable. Updated daily.
            </p>
          </div>
          <div class="dir-paywall__right">
            <div class="dir-paywall__option">
              <div class="dir-paywall__option-label">For AI Agents</div>
              <div class="dir-paywall__option-title">Directory API</div>
              <div class="dir-paywall__option-desc">Query the full catalog programmatically. x402-gated — pay per request in USDC on Base. No API key.</div>
              <a href="https://api.24klabs.ai" target="_blank" rel="noopener" class="btn btn--outline btn--sm">
                api.24klabs.ai ↗
              </a>
            </div>
            <div class="dir-paywall__divider"></div>
            <div class="dir-paywall__option">
              <div class="dir-paywall__option-label">For Humans</div>
              <div class="dir-paywall__option-title">Full Access</div>
              <div class="dir-paywall__option-desc">Unlock the complete catalog in-browser. Pay once via x402 USDC on Base.</div>
              <button class="btn btn--gold btn--sm" id="unlock-btn">
                Unlock Full Catalog
              </button>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

</BaseLayout>

<style>
  /* ================================================================
     HEADER
  ================================================================ */
  .dir-header {
    position: relative;
    padding: 96px 0 0;
    overflow: hidden;
  }
  .dir-header__glow {
    position: absolute;
    top: -200px; left: 50%;
    transform: translateX(-50%);
    width: 1000px; height: 500px;
    background: radial-gradient(ellipse, rgba(212,175,55,0.07) 0%, transparent 65%);
    pointer-events: none;
  }
  .dir-header__top {
    text-align: center;
    padding-bottom: 48px;
  }
  .dir-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gold);
    border: 1px solid rgba(212,175,55,0.2);
    background: rgba(212,175,55,0.05);
    padding: 5px 12px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  .dir-header__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: 12px;
    line-height: 1.05;
  }
  .dir-header__desc {
    color: var(--text-muted);
    font-size: 0.98rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Stats strip */
  .dir-stats-strip {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
  }
  .dir-stat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 28px;
    flex: 1;
  }
  .dir-stat-card--action { flex: 0; padding: 16px 24px; }
  .dir-stat-card__icon { font-size: 1rem; color: var(--gold-dim); flex-shrink: 0; }
  .dir-stat-card__value { display: block; font-size: 1.1rem; font-weight: 800; color: var(--gold); letter-spacing: -0.03em; }
  .dir-stat-card__label { display: block; font-size: 0.62rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.09em; margin-top: 2px; }
  .dir-stat-divider { width: 1px; height: 36px; background: var(--border); flex-shrink: 0; }

  /* ================================================================
     APP LAYOUT
  ================================================================ */
  .dir-app {
    display: grid;
    grid-template-columns: 220px 1fr;
    align-items: start;
    padding-bottom: 80px;
    border-top: 1px solid var(--border);
  }

  /* ================================================================
     SIDEBAR
  ================================================================ */
  .dir-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 20px);
    display: flex;
    flex-direction: column;
    gap: 0;
    border-right: 1px solid var(--border);
    padding: 24px 20px 24px 0;
    min-height: 60vh;
  }
  .dir-search-wrap { position: relative; margin-bottom: 24px; }
  .dir-search-icon {
    position: absolute; left: 10px; top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim); font-size: 15px; pointer-events: none;
  }
  .dir-search {
    width: 100%; padding: 9px 30px 9px 32px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-sm); color: var(--text);
    font-size: 0.83rem; font-family: var(--font);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .dir-search:focus { outline: none; border-color: var(--gold-dim); box-shadow: 0 0 0 3px rgba(212,175,55,0.08); }
  .dir-search::placeholder { color: var(--text-dim); }
  .dir-search-clear {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    color: var(--text-dim); cursor: pointer; font-size: 11px;
  }
  .dir-filter-section { margin-bottom: 20px; }
  .dir-filter-section__header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .dir-filter-section__line { flex: 1; height: 1px; background: var(--border); }
  .dir-filter-section__label {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-dim); white-space: nowrap;
  }
  .dir-filter__list { display: flex; flex-direction: column; gap: 1px; }
  .dir-pill {
    width: 100%; text-align: left; padding: 6px 10px;
    border-radius: var(--radius-sm); border: none; background: transparent;
    color: var(--text-muted); font-size: 0.8rem; font-family: var(--font);
    cursor: pointer; transition: all 0.15s; position: relative;
  }
  .dir-pill:hover { background: var(--bg-card); color: var(--text); }
  .dir-pill.active { background: rgba(212,175,55,0.08); color: var(--gold); font-weight: 600; }
  .dir-pill.active::before {
    content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
    width: 2px; background: var(--gold); border-radius: 2px;
  }
  .dir-toggle {
    display: flex; align-items: center; gap: 9px;
    cursor: pointer; padding: 6px 10px;
  }
  .dir-toggle input { display: none; }
  .dir-toggle__track {
    width: 32px; height: 17px; border-radius: 100px;
    background: var(--border); position: relative; flex-shrink: 0;
    transition: background 0.2s; border: 1px solid rgba(255,255,255,0.05);
  }
  .dir-toggle__thumb {
    position: absolute; top: 2px; left: 2px;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--text-dim); transition: all 0.2s;
  }
  .dir-toggle input:checked ~ .dir-toggle__track { background: rgba(212,175,55,0.3); border-color: var(--gold-dim); }
  .dir-toggle input:checked ~ .dir-toggle__track .dir-toggle__thumb { left: 17px; background: var(--gold); }
  .dir-toggle__label { font-size: 0.8rem; color: var(--text-muted); }
  .dir-clear {
    margin-top: auto; padding: 8px 10px;
    border-radius: var(--radius-sm); border: 1px dashed var(--border);
    background: transparent; color: var(--text-dim);
    font-size: 0.76rem; font-family: var(--font);
    cursor: pointer; transition: all 0.15s; text-align: center;
  }
  .dir-clear:hover { border-color: var(--text-dim); color: var(--text-muted); background: var(--bg-card); }

  /* ================================================================
     MAIN
  ================================================================ */
  .dir-main { min-width: 0; padding: 24px 0 24px 28px; }

  .dir-results-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; padding: 10px 16px;
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .dir-results-left { display: flex; align-items: center; gap: 10px; }
  .dir-results-count { font-size: 0.82rem; color: var(--text-dim); }
  .dir-results-count strong { color: var(--gold); }
  .dir-results-tag {
    font-size: 0.7rem; color: var(--text-dim);
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 100px; padding: 2px 8px;
    font-family: var(--mono); display: none;
  }
  .dir-results-tag:not(:empty) { display: inline; }
  .dir-results-hint { font-size: 0.7rem; color: var(--text-dim); font-family: var(--mono); }

  /* ================================================================
     GRID + CARDS
  ================================================================ */
  .dir-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

  .service-card {
    background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px 18px 14px;
    display: flex; flex-direction: column;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    text-decoration: none; color: var(--text);
    position: relative; overflow: hidden;
  }
  .service-card::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.3), transparent);
    opacity: 0; transition: opacity 0.2s;
  }
  .service-card:hover {
    border-color: rgba(212,175,55,0.25);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    transform: translateY(-1px); color: var(--text);
  }
  .service-card:hover::after { opacity: 1; }
  .service-card.is-verified { border-color: rgba(212,175,55,0.2); }
  .service-card.is-verified::after { opacity: 1; }

  .card-name {
    font-size: 0.93rem; font-weight: 700; line-height: 1.3; color: var(--text);
    margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .is-verified .card-name { color: var(--gold); }

  .card-tags {
    display: flex; gap: 5px; align-items: center;
    margin-bottom: 10px; overflow: hidden;
  }
  .card-tag {
    font-size: 0.6rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; padding: 2px 6px; border-radius: 3px;
    white-space: nowrap; flex-shrink: 0;
  }
  .card-tag--section { background: rgba(124,109,240,0.1); color: #9d8ff5; border: 1px solid rgba(124,109,240,0.18); }
  .card-tag--category { background: rgba(255,255,255,0.04); color: var(--text-dim); border: 1px solid var(--border); }
  .card-tag--verified { background: rgba(212,175,55,0.1); color: var(--gold); border: 1px solid rgba(212,175,55,0.2); }

  .card-desc {
    font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; margin-bottom: 14px;
  }

  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 11px; border-top: 1px solid var(--border);
    margin-top: auto; gap: 8px;
  }
  .card-section-label {
    font-size: 0.65rem; color: var(--text-dim);
    text-transform: uppercase; letter-spacing: 0.06em;
    font-family: var(--mono);
  }
  .card-link {
    font-size: 0.7rem; color: var(--text-dim);
    transition: color 0.15s; flex-shrink: 0;
  }
  .service-card:hover .card-link { color: var(--gold); }

  /* Empty */
  .dir-empty { text-align: center; padding: 80px 0; color: var(--text-dim); }
  .dir-empty__icon { font-size: 2rem; margin-bottom: 16px; opacity: 0.3; }
  .dir-empty p { margin-bottom: 16px; font-size: 0.9rem; }

  /* Pagination */
  .dir-pagination {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin-top: 40px; padding: 24px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-surface);
  }
  .dir-page-info { font-size: 0.82rem; color: var(--text-muted); font-family: var(--mono); }

  /* ================================================================
     PAYWALL
  ================================================================ */
  .dir-paywall {
    margin-top: 48px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
  }
  /* Top gold line */
  .dir-paywall::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .dir-paywall__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .dir-paywall__left {
    padding: 40px;
    background: linear-gradient(135deg, rgba(212,175,55,0.04) 0%, transparent 60%);
    border-right: 1px solid var(--border);
  }
  .dir-paywall__eyebrow {
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--gold-dim); margin-bottom: 12px;
  }
  .dir-paywall__count {
    font-size: 3.5rem; font-weight: 900; color: var(--gold);
    letter-spacing: -0.05em; line-height: 1; margin-bottom: 4px;
  }
  .dir-paywall__label {
    font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;
  }
  .dir-paywall__desc {
    font-size: 0.82rem; color: var(--text-dim); line-height: 1.65; max-width: 320px;
  }
  .dir-paywall__right {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding: 0;
  }
  .dir-paywall__option {
    padding: 36px 32px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .dir-paywall__option-label {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-dim);
  }
  .dir-paywall__option-title {
    font-size: 1rem; font-weight: 700; color: var(--text);
  }
  .dir-paywall__option-desc {
    font-size: 0.78rem; color: var(--text-muted); line-height: 1.6; flex: 1;
  }
  .dir-paywall__divider {
    width: 1px; background: var(--border);
    margin: 24px 0;
    align-self: stretch;
  }

  /* ================================================================
     RESPONSIVE
  ================================================================ */
  @media (max-width: 1100px) { .dir-grid { grid-template-columns: 1fr; } }
  @media (max-width: 860px) {
    .dir-app { grid-template-columns: 1fr; border-top: none; }
    .dir-sidebar { position: static; border-right: none; border-bottom: 1px solid var(--border); padding: 20px 0; min-height: unset; }
    .dir-filter__list { flex-direction: row; flex-wrap: wrap; gap: 4px; }
    .dir-pill { width: auto; }
    .dir-main { padding: 20px 0 0; }
    .dir-stats-strip { flex-wrap: wrap; }
    .dir-stat-card { flex: none; min-width: 45%; }
    .dir-stat-divider { display: none; }
    .dir-paywall__inner { grid-template-columns: 1fr; }
    .dir-paywall__left { border-right: none; border-bottom: 1px solid var(--border); }
    .dir-paywall__right { grid-template-columns: 1fr; }
    .dir-paywall__divider { width: 100%; height: 1px; margin: 0 24px; }
  }
</style>

<script define:vars={{ EDITORIAL_JSON }}>
const ALL_ENTRIES = JSON.parse(EDITORIAL_JSON);
const PAGE_SIZE = 24;

let filtered = [];
let currentPage = 1;
let activeSection = 'all';
let verifiedOnly = false;
let searchQuery = '';

function esc(str) {
  return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function buildCard(e) {
  return `
    <a href="${esc(e.url) || '#'}" target="_blank" rel="noopener noreferrer"
       class="service-card${e.verified ? ' is-verified' : ''} reveal">
      <div class="card-name">${esc(e.name)}</div>
      <div class="card-tags">
        <span class="card-tag card-tag--section">${esc(e.section_label)}</span>
        ${e.category ? `<span class="card-tag card-tag--category">${esc(e.category)}</span>` : ''}
        ${e.verified ? '<span class="card-tag card-tag--verified">24K Verified</span>' : ''}
      </div>
      <div class="card-desc">${esc(e.desc) || 'x402-enabled service.'}</div>
      <div class="card-footer">
        <span class="card-section-label">${esc(e.section_label)}</span>
        <span class="card-link">Visit ↗</span>
      </div>
    </a>`;
}

function applyFilters() {
  const q = searchQuery.toLowerCase();
  filtered = ALL_ENTRIES.filter(e => {
    if (verifiedOnly && !e.verified) return false;
    if (activeSection !== 'all' && e.section_label !== activeSection) return false;
    if (q) {
      const hay = [e.name, e.desc, e.section_label, e.category].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });
  currentPage = 1;
  render();
}

function render() {
  const grid = document.getElementById('services-grid');
  const empty = document.getElementById('empty-state');
  const pag = document.getElementById('pagination');

  document.getElementById('total-count').textContent = filtered.length.toLocaleString();

  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    pag.style.display = 'none';
    document.getElementById('showing-count').textContent = '0';
    return;
  }
  empty.style.display = 'none';

  const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
  const start = (currentPage - 1) * PAGE_SIZE;
  const page = filtered.slice(start, start + PAGE_SIZE);

  document.getElementById('showing-count').textContent = page.length.toLocaleString();
  grid.innerHTML = page.map(buildCard).join('');

  if (totalPages > 1) {
    pag.style.display = 'flex';
    document.getElementById('page-info').textContent = `Page ${currentPage} of ${totalPages}`;
    document.getElementById('prev-page').disabled = currentPage === 1;
    document.getElementById('next-page').disabled = currentPage === totalPages;
  } else {
    pag.style.display = 'none';
  }

  requestAnimationFrame(() => {
    document.querySelectorAll('.reveal:not(.visible)').forEach((el, i) => {
      setTimeout(() => el.classList.add('visible'), i * 15);
    });
  });

  // Update active filter label
  const parts = [];
  if (activeSection !== 'all') parts.push(activeSection);
  if (verifiedOnly) parts.push('Verified');
  document.getElementById('results-label').textContent = parts.join(' · ');
}

// Events
document.getElementById('search').addEventListener('input', e => {
  searchQuery = e.target.value;
  document.getElementById('search-clear').style.display = searchQuery ? 'block' : 'none';
  applyFilters();
});
document.getElementById('search-clear').addEventListener('click', () => {
  document.getElementById('search').value = '';
  searchQuery = '';
  document.getElementById('search-clear').style.display = 'none';
  applyFilters();
});
document.getElementById('section-pills').addEventListener('click', e => {
  const pill = e.target.closest('.dir-pill');
  if (!pill) return;
  document.querySelectorAll('#section-pills .dir-pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  activeSection = pill.dataset.value;
  applyFilters();
});
document.getElementById('verified-only').addEventListener('change', e => {
  verifiedOnly = e.target.checked;
  applyFilters();
});
document.getElementById('prev-page').addEventListener('click', () => {
  if (currentPage > 1) { currentPage--; render(); window.scrollTo(0,200); }
});
document.getElementById('next-page').addEventListener('click', () => {
  if (currentPage < Math.ceil(filtered.length / PAGE_SIZE)) { currentPage++; render(); window.scrollTo(0,200); }
});

function clearAll() {
  searchQuery = ''; activeSection = 'all'; verifiedOnly = false;
  document.getElementById('search').value = '';
  document.getElementById('verified-only').checked = false;
  document.querySelectorAll('.dir-pill').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.dir-pill[data-value="all"]').forEach(p => p.classList.add('active'));
  applyFilters();
}
document.getElementById('clear-filters').addEventListener('click', clearAll);
document.getElementById('clear-filters-2').addEventListener('click', clearAll);

// Unlock button — placeholder for x402 integration
document.getElementById('unlock-btn').addEventListener('click', () => {
  // TODO: trigger x402 payment flow
  alert('x402 payment integration coming soon. Use the API endpoint at api.24klabs.ai for programmatic access.');
});

// Init
applyFilters();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Gold-402 Directory — 24K Labs" description="The open x402 service directory. 26,000+ x402 endpoints. Curated by 24K Labs.">

  <!-- PAGE HEADER -->
  <section class="dir-header">
    <div class="dir-header__glow"></div>
    <div class="container">
      <div class="dir-header__top">
        <div class="dir-header__badge">
          <span class="live-dot"></span>Live Directory
        </div>
        <h1 class="dir-header__title">Gold-402 <span class="text-gold">Directory</span></h1>
        <p class="dir-header__desc">The open x402 service directory. Verified endpoints. Curated by 24K Labs.</p>
      </div>

      <!-- Stats strip -->
      <div class="dir-stats-strip" id="stats-bar">
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">◈</div>
          <div>
            <span class="dir-stat-card__value" id="stat-total">—</span>
            <span class="dir-stat-card__label">Total Services</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">◉</div>
          <div>
            <span class="dir-stat-card__value" id="stat-active">—</span>
            <span class="dir-stat-card__label">Active</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">⬡</div>
          <div>
            <span class="dir-stat-card__value">Base L2</span>
            <span class="dir-stat-card__label">Primary Network</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card">
          <div class="dir-stat-card__icon">↻</div>
          <div>
            <span class="dir-stat-card__value" id="stat-updated">—</span>
            <span class="dir-stat-card__label">Updated</span>
          </div>
        </div>
        <div class="dir-stat-divider"></div>
        <div class="dir-stat-card dir-stat-card--action">
          <a href="https://github.com/Haustorium12/gold-402/blob/main/CONTRIBUTING.md"
             target="_blank" rel="noopener" class="btn btn--gold btn--sm">
            Get Listed ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- APP LAYOUT -->
  <div class="dir-app container">

    <!-- SIDEBAR -->
    <aside class="dir-sidebar">

      <!-- Search -->
      <div class="dir-search-wrap">
        <span class="dir-search-icon">⌕</span>
        <input class="dir-search" id="search" type="text" placeholder="Search services..." />
        <span class="dir-search-clear" id="search-clear" style="display:none">✕</span>
      </div>

      <!-- Type filter -->
      <div class="dir-filter-section">
        <div class="dir-filter-section__header">
          <span class="dir-filter-section__line"></span>
          <span class="dir-filter-section__label">Type</span>
          <span class="dir-filter-section__line"></span>
        </div>
        <div class="dir-filter__list" id="type-pills">
          <button class="dir-pill active" data-value="all">All Types</button>
          <button class="dir-pill" data-value="API / Service">API / Service</button>
          <button class="dir-pill" data-value="Facilitator">Facilitator</button>
          <button class="dir-pill" data-value="SDK / Library">SDK / Library</button>
          <button class="dir-pill" data-value="MCP Server">MCP Server</button>
          <button class="dir-pill" data-value="Tool">Tool</button>
          <button class="dir-pill" data-value="Wallet">Wallet</button>
          <button class="dir-pill" data-value="Directory / Aggregator">Directory</button>
          <button class="dir-pill" data-value="Learning Resource">Learning</button>
        </div>
      </div>

      <!-- Domain filter -->
      <div class="dir-filter-section">
        <div class="dir-filter-section__header">
          <span class="dir-filter-section__line"></span>
          <span class="dir-filter-section__label">Domain</span>
          <span class="dir-filter-section__line"></span>
        </div>
        <div class="dir-filter__list" id="domain-pills">
          <button class="dir-pill active" data-value="all">All Domains</button>
          <button class="dir-pill" data-value="AI">AI</button>
          <button class="dir-pill" data-value="Developer Tools">Dev Tools</button>
          <button class="dir-pill" data-value="Agent / Automation">Agents</button>
          <button class="dir-pill" data-value="Infrastructure">Infrastructure</button>
          <button class="dir-pill" data-value="Security">Security</button>
          <button class="dir-pill" data-value="Finance / DeFi">Finance</button>
          <button class="dir-pill" data-value="Analytics / Monitoring">Analytics</button>
          <button class="dir-pill" data-value="Data">Data</button>
          <button class="dir-pill" data-value="Identity">Identity</button>
          <button class="dir-pill" data-value="Payments / Commerce">Payments</button>
          <button class="dir-pill" data-value="Compliance / Legal">Compliance</button>
          <button class="dir-pill" data-value="Storage">Storage</button>
          <button class="dir-pill" data-value="NFT">NFT</button>
          <button class="dir-pill" data-value="Gaming">Gaming</button>
          <button class="dir-pill" data-value="Media">Media</button>
          <button class="dir-pill" data-value="Testing / Mocking">Testing</button>
        </div>
      </div>

      <!-- Options -->
      <div class="dir-filter-section">
        <div class="dir-filter-section__header">
          <span class="dir-filter-section__line"></span>
          <span class="dir-filter-section__label">Options</span>
          <span class="dir-filter-section__line"></span>
        </div>
        <label class="dir-toggle">
          <input type="checkbox" id="verified-only" />
          <span class="dir-toggle__track"><span class="dir-toggle__thumb"></span></span>
          <span class="dir-toggle__label">Active only</span>
        </label>
      </div>

      <!-- Clear -->
      <button class="dir-clear" id="clear-filters">↺ Reset filters</button>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="dir-main">

      <!-- Results bar -->
      <div class="dir-results-bar">
        <div class="dir-results-left">
          <span class="dir-results-count">
            <strong id="showing-count">—</strong> of <strong id="total-count">—</strong> services
          </span>
          <span class="dir-results-tag" id="results-label"></span>
        </div>
        <div class="dir-results-right">
          <span class="dir-results-hint">Sorted by activity</span>
        </div>
      </div>

      <!-- Loading -->
      <div id="loading-state" class="dir-loading">
        <div class="dir-loading__inner">
          <div class="dir-spinner"></div>
          <span>Loading directory...</span>
        </div>
      </div>

      <!-- Grid -->
      <div class="dir-grid" id="services-grid"></div>

      <!-- Empty -->
      <div id="empty-state" class="dir-empty" style="display:none">
        <div class="dir-empty__icon">◈</div>
        <p>No services match your filters.</p>
        <button class="btn btn--outline btn--sm" id="clear-filters-2">Reset filters</button>
      </div>

      <!-- Pagination -->
      <div class="dir-pagination" id="pagination" style="display:none">
        <button class="btn btn--outline btn--sm" id="prev-page">← Prev</button>
        <span class="dir-page-info" id="page-info"></span>
        <button class="btn btn--outline btn--sm" id="next-page">Next →</button>
      </div>

    </main>
  </div>

</BaseLayout>

<style>
  /* ================================================================
     HEADER
  ================================================================ */
  .dir-header {
    position: relative;
    padding: 96px 0 0;
    overflow: hidden;
  }
  .dir-header__glow {
    position: absolute;
    top: -200px; left: 50%;
    transform: translateX(-50%);
    width: 1000px; height: 500px;
    background: radial-gradient(ellipse, rgba(212,175,55,0.07) 0%, transparent 65%);
    pointer-events: none;
  }
  .dir-header__top {
    text-align: center;
    padding-bottom: 48px;
  }
  .dir-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gold);
    border: 1px solid rgba(212,175,55,0.2);
    background: rgba(212,175,55,0.05);
    padding: 5px 12px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(212,175,55,0.4)} 50%{opacity:0.6;box-shadow:0 0 0 4px rgba(212,175,55,0)} }
  .dir-header__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: 12px;
    line-height: 1.05;
  }
  .dir-header__desc {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Stats strip */
  .dir-stats-strip {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
  }
  .dir-stat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 28px;
    flex: 1;
  }
  .dir-stat-card--action {
    flex: 0;
    padding: 16px 24px;
    margin-left: auto;
  }
  .dir-stat-card__icon {
    font-size: 1.1rem;
    color: var(--gold-dim);
    flex-shrink: 0;
    line-height: 1;
  }
  .dir-stat-card__value {
    display: block;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .dir-stat-card__label {
    display: block;
    font-size: 0.62rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-top: 2px;
  }
  .dir-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ================================================================
     APP LAYOUT
  ================================================================ */
  .dir-app {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0;
    align-items: start;
    padding-bottom: 80px;
    border-top: 1px solid var(--border);
  }

  /* ================================================================
     SIDEBAR
  ================================================================ */
  .dir-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 20px);
    display: flex;
    flex-direction: column;
    gap: 0;
    border-right: 1px solid var(--border);
    padding: 24px 20px 24px 0;
    min-height: 70vh;
  }

  /* Search */
  .dir-search-wrap {
    position: relative;
    margin-bottom: 24px;
  }
  .dir-search-icon {
    position: absolute;
    left: 10px; top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    font-size: 15px;
    pointer-events: none;
  }
  .dir-search {
    width: 100%;
    padding: 9px 30px 9px 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.83rem;
    font-family: var(--font);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .dir-search:focus {
    outline: none;
    border-color: var(--gold-dim);
    box-shadow: 0 0 0 3px rgba(212,175,55,0.08);
  }
  .dir-search::placeholder { color: var(--text-dim); }
  .dir-search-clear {
    position: absolute;
    right: 10px; top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    cursor: pointer;
    font-size: 11px;
    width: 16px; height: 16px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    transition: background 0.15s, color 0.15s;
  }
  .dir-search-clear:hover { background: var(--border); color: var(--text); }

  /* Filter sections */
  .dir-filter-section {
    margin-bottom: 20px;
  }
  .dir-filter-section__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .dir-filter-section__line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .dir-filter-section__label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .dir-filter__list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .dir-pill {
    width: 100%;
    text-align: left;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
  }
  .dir-pill:hover {
    background: var(--bg-card);
    color: var(--text);
  }
  .dir-pill.active {
    background: rgba(212,175,55,0.08);
    color: var(--gold);
    font-weight: 600;
  }
  .dir-pill.active::before {
    content: '';
    position: absolute;
    left: 0; top: 20%; bottom: 20%;
    width: 2px;
    background: var(--gold);
    border-radius: 2px;
  }

  /* Toggle */
  .dir-toggle {
    display: flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    padding: 6px 10px;
  }
  .dir-toggle input { display: none; }
  .dir-toggle__track {
    width: 32px; height: 17px;
    border-radius: 100px;
    background: var(--border);
    position: relative;
    flex-shrink: 0;
    transition: background 0.2s;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .dir-toggle__thumb {
    position: absolute;
    top: 2px; left: 2px;
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.2s;
  }
  .dir-toggle input:checked ~ .dir-toggle__track { background: rgba(212,175,55,0.3); border-color: var(--gold-dim); }
  .dir-toggle input:checked ~ .dir-toggle__track .dir-toggle__thumb { left: 17px; background: var(--gold); }
  .dir-toggle__label { font-size: 0.8rem; color: var(--text-muted); }

  /* Clear */
  .dir-clear {
    margin-top: auto;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border);
    background: transparent;
    color: var(--text-dim);
    font-size: 0.76rem;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .dir-clear:hover { border-color: var(--text-dim); color: var(--text-muted); background: var(--bg-card); }

  /* ================================================================
     MAIN CONTENT
  ================================================================ */
  .dir-main {
    min-width: 0;
    padding: 24px 0 24px 28px;
  }

  /* Results bar */
  .dir-results-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding: 10px 16px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .dir-results-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dir-results-count {
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .dir-results-count strong { color: var(--gold); font-variant-numeric: tabular-nums; }
  .dir-results-tag {
    font-size: 0.7rem;
    color: var(--text-dim);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 2px 8px;
    font-family: var(--mono);
    display: none;
  }
  .dir-results-tag:not(:empty) { display: inline; }
  .dir-results-right {}
  .dir-results-hint {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-family: var(--mono);
  }

  /* Loading */
  .dir-loading { padding: 80px 0; }
  .dir-loading__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-dim);
    font-size: 0.87rem;
  }
  .dir-spinner {
    width: 16px; height: 16px;
    border-radius: 50%;
    border: 2px solid var(--border);
    border-top-color: var(--gold);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ================================================================
     GRID + CARDS
  ================================================================ */
  .dir-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .service-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 18px 14px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
  }
  .service-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.3), transparent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .service-card:hover {
    border-color: rgba(212,175,55,0.25);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    transform: translateY(-1px);
    color: var(--text);
  }
  .service-card:hover::after { opacity: 1; }
  .service-card.is-24k {
    border-color: rgba(212,175,55,0.2);
  }
  .service-card.is-24k::after { opacity: 1; }

  /* Name row */
  .card-name {
    font-size: 0.93rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .is-24k .card-name { color: var(--gold); }

  /* Tag row — single compact line */
  .card-tags {
    display: flex;
    gap: 5px;
    align-items: center;
    margin-bottom: 10px;
    flex-wrap: nowrap;
    overflow: hidden;
  }
  .card-tag {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .card-tag--type {
    background: rgba(124,109,240,0.1);
    color: #9d8ff5;
    border: 1px solid rgba(124,109,240,0.18);
  }
  .card-tag--domain {
    background: rgba(255,255,255,0.04);
    color: var(--text-dim);
    border: 1px solid var(--border);
  }
  .card-tag--verified {
    background: rgba(78,205,196,0.08);
    color: #4ecdc4;
    border: 1px solid rgba(78,205,196,0.18);
  }

  /* Description */
  .card-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 14px;
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 11px;
    border-top: 1px solid var(--border);
    margin-top: auto;
    gap: 8px;
  }
  .card-price {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--gold);
    font-family: var(--mono);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .card-activity {
    font-size: 0.68rem;
    color: var(--text-dim);
    flex: 1;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-link {
    font-size: 0.7rem;
    color: var(--text-dim);
    transition: color 0.15s;
    flex-shrink: 0;
    letter-spacing: 0.03em;
  }
  .service-card:hover .card-link { color: var(--gold); }

  /* Prompt card */
  .prompt-msg {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 24px;
    color: var(--text-muted);
    font-size: 0.88rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    line-height: 1.7;
  }

  /* Empty */
  .dir-empty {
    text-align: center;
    padding: 80px 0;
    color: var(--text-dim);
  }
  .dir-empty__icon {
    font-size: 2rem;
    margin-bottom: 16px;
    opacity: 0.3;
  }
  .dir-empty p { margin-bottom: 16px; font-size: 0.9rem; }

  /* Pagination */
  .dir-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
  }
  .dir-page-info {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--mono);
  }

  /* ================================================================
     RESPONSIVE
  ================================================================ */
  @media (max-width: 1100px) {
    .dir-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .dir-app { grid-template-columns: 1fr; border-top: none; }
    .dir-sidebar {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 20px 0;
      min-height: unset;
    }
    .dir-filter__list { flex-direction: row; flex-wrap: wrap; gap: 4px; }
    .dir-pill { width: auto; }
    .dir-stats-strip { flex-wrap: wrap; }
    .dir-stat-card { flex: none; min-width: 45%; }
    .dir-stat-divider { display: none; }
    .dir-main { padding: 20px 0 0; }
  }
  @media (max-width: 600px) {
    .dir-stats-strip { border-radius: 8px 8px 0 0; }
    .dir-stat-card { padding: 16px 20px; }
    .dir-grid { grid-template-columns: 1fr; }
    .dir-stat-card--action { min-width: 100%; text-align: center; justify-content: center; }
  }
</style>

<script>
const BASE_URL = 'https://raw.githubusercontent.com/Haustorium12/gold-402/main/directory/by_type/';
const MANIFEST_URL = BASE_URL + 'manifest.json';
const FEATURED_URL = BASE_URL + 'featured.json';
const PAGE_SIZE = 20;

const TYPE_TO_SLUG = {
  'API / Service': 'api-service',
  'Facilitator': 'facilitator',
  'SDK / Library': 'sdk-library',
  'MCP Server': 'mcp-server',
  'Tool': 'tool',
  'Wallet': 'wallet',
  'Directory / Aggregator': 'directory-aggregator',
  'Learning Resource': 'learning-resource',
};
const SMALL_TYPES = new Set(['Facilitator','SDK / Library','MCP Server','Tool','Wallet','Directory / Aggregator','Learning Resource']);

let manifest = null;
let featured = [];
let sliceCache = new Map();
let currentServices = [];
let filtered = [];
let currentPage = 1;
let activeType = 'all';
let activeDomain = 'all';
let verifiedOnly = false;
let searchQuery = '';
let loadToken = 0;

function esc(str) {
  return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function formatPrice(min, max) {
  if (min == null && max == null) return null;
  if (min != null && max != null && min !== max) return '$' + fmt(min) + '–$' + fmt(max);
  if (min != null) return '$' + fmt(min);
  return '$' + fmt(max);
}
function fmt(n) {
  if (n < 0.01) return n.toFixed(4).replace(/\.?0+$/,'');
  if (n < 1) return n.toFixed(3).replace(/\.?0+$/,'');
  if (n < 100) return n.toFixed(2).replace(/\.?0+$/,'');
  return Math.round(n).toLocaleString();
}
function formatActivity(calls, payers) {
  if (payers) return payers.toLocaleString() + ' payers/mo base';
  if (calls) return calls.toLocaleString() + ' calls/mo base';
  return null;
}
function is24k(s) { return s.website_url && s.website_url.includes('24klabs.ai'); }
function sourceLabel(s) {
  if (s.source === 'agentic-market') return 'Agentic.market';
  return null;
}

function buildCard(s) {
  const price = formatPrice(s.price_min, s.price_max);
  const activity = formatActivity(s.quality_calls_30d, s.quality_payers_30d);
  const domain = (s.domain_tags || [])[0];
  const twentyk = is24k(s);
  return `
    <a href="${esc(s.website_url) || '#'}" target="_blank" rel="noopener noreferrer"
       class="service-card${twentyk ? ' is-24k' : ''} reveal">
      <div class="card-name">${esc(s.name) || 'Unnamed'}</div>
      <div class="card-tags">
        <span class="card-tag card-tag--type">${esc(s.type) || 'Service'}</span>
        ${domain ? `<span class="card-tag card-tag--domain">${esc(domain)}</span>` : ''}
        ${s.verified ? '<span class="card-tag card-tag--verified">● Active</span>' : ''}
      </div>
      <div class="card-desc">${esc(s.short_desc) || 'x402-enabled service.'}</div>
      <div class="card-footer">
        <span class="card-price">${price || '—'}</span>
        ${activity ? `<span class="card-activity">${activity}</span>` : ''}
        <span class="card-link">Visit ↗</span>
      </div>
    </a>`;
}

function render() {
  const grid = document.getElementById('services-grid');
  const empty = document.getElementById('empty-state');
  const pag = document.getElementById('pagination');

  document.getElementById('total-count').textContent = filtered.length.toLocaleString();

  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    pag.style.display = 'none';
    document.getElementById('showing-count').textContent = '0';
    return;
  }
  empty.style.display = 'none';

  const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
  const start = (currentPage - 1) * PAGE_SIZE;
  const page = filtered.slice(start, start + PAGE_SIZE);

  document.getElementById('showing-count').textContent = page.length.toLocaleString();
  grid.innerHTML = page.map(s => buildCard(s)).join('');

  if (totalPages > 1) {
    pag.style.display = 'flex';
    document.getElementById('page-info').textContent = `Page ${currentPage} of ${totalPages.toLocaleString()}`;
    (document.getElementById('prev-page') as HTMLButtonElement).disabled = currentPage === 1;
    (document.getElementById('next-page') as HTMLButtonElement).disabled = currentPage === totalPages;
  } else {
    pag.style.display = 'none';
  }

  requestAnimationFrame(() => {
    document.querySelectorAll('.reveal:not(.visible)').forEach((el, i) => {
      setTimeout(() => el.classList.add('visible'), i * 18);
    });
  });
}

async function fetchSlice(filename) {
  if (sliceCache.has(filename)) return sliceCache.get(filename);
  const res = await fetch(BASE_URL + filename);
  if (!res.ok) throw new Error('Failed: ' + filename);
  const data = await res.json();
  const services = data.services || [];
  sliceCache.set(filename, services);
  return services;
}

function matchingSlices(type, domain) {
  if (!manifest) return [];
  const slices = manifest.slices.filter(s => s.kind !== 'featured');
  if (type === 'all' && domain === 'all') return [];
  if (type === 'all' && domain !== 'all') {
    return slices.filter(s =>
      (s.type === 'API / Service' && s.tag === domain) ||
      (s.type !== 'API / Service' && s.tag === null)
    );
  }
  if (type !== 'all' && domain === 'all') {
    if (SMALL_TYPES.has(type)) return slices.filter(s => s.type === type && s.tag === null);
    return [];
  }
  if (type === 'API / Service') return slices.filter(s => s.type === 'API / Service' && s.tag === domain);
  return slices.filter(s => s.type === type && s.tag === null);
}

function updateResultsLabel() {
  const parts = [];
  if (activeType !== 'all') parts.push(activeType);
  if (activeDomain !== 'all') parts.push(activeDomain);
  document.getElementById('results-label').textContent = parts.join(' · ');
}

async function loadCurrentView() {
  const myToken = ++loadToken;
  const targets = matchingSlices(activeType, activeDomain);
  const grid = document.getElementById('services-grid');
  const loadingEl = document.getElementById('loading-state');

  updateResultsLabel();

  if (activeType === 'all' && activeDomain === 'all') {
    currentServices = featured.slice();
    loadingEl.style.display = 'none';
    applyFilters();
    return;
  }
  if (activeType === 'API / Service' && activeDomain === 'all') {
    currentServices = [];
    loadingEl.style.display = 'none';
    grid.innerHTML = '<div class="prompt-msg">37,000+ API services available — pick a domain to narrow results.</div>';
    document.getElementById('total-count').textContent = '37,899';
    document.getElementById('showing-count').textContent = '—';
    document.getElementById('pagination').style.display = 'none';
    document.getElementById('empty-state').style.display = 'none';
    return;
  }
  if (targets.length === 0) {
    currentServices = [];
    loadingEl.style.display = 'none';
    applyFilters();
    return;
  }

  const uncached = targets.filter(t => !sliceCache.has(t.filename));
  if (uncached.length > 0) loadingEl.style.display = 'block';

  try {
    const results = await Promise.all(targets.map(t => fetchSlice(t.filename)));
    if (myToken !== loadToken) return;

    const seen = new Set();
    const merged = [];
    for (const slice of results) {
      for (const s of slice) {
        const id = s.id || (s.name + '|' + (s.api_base_url || ''));
        if (!seen.has(id)) { seen.add(id); merged.push(s); }
      }
    }

    if (activeType === 'all' && activeDomain !== 'all') {
      currentServices = merged.filter(s =>
        s.type === 'API / Service' || (s.domain_tags || []).includes(activeDomain)
      );
    } else if (SMALL_TYPES.has(activeType) && activeDomain !== 'all') {
      currentServices = merged.filter(s => (s.domain_tags || []).includes(activeDomain));
    } else {
      currentServices = merged;
    }

    loadingEl.style.display = 'none';
    applyFilters();
  } catch(e) {
    if (myToken !== loadToken) return;
    loadingEl.innerHTML = '<div class="dir-loading__inner">Failed to load. <a href="https://github.com/Haustorium12/gold-402" target="_blank" style="color:var(--gold)">View on GitHub ↗</a></div>';
  }
}

function applyFilters() {
  const q = searchQuery.toLowerCase();
  filtered = currentServices.filter(s => {
    if (verifiedOnly && !s.verified) return false;
    if (q) {
      const hay = [s.name, s.short_desc, ...(s.domain_tags || [])].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });
  currentPage = 1;
  render();
}

async function init() {
  try {
    const [mRes, fRes] = await Promise.all([
      fetch(MANIFEST_URL).then(r => r.json()),
      fetch(FEATURED_URL).then(r => r.json()),
    ]);
    manifest = mRes;
    featured = fRes.services || [];

    document.getElementById('loading-state').style.display = 'none';
    document.getElementById('stat-total').textContent = manifest.total_services?.toLocaleString() || '—';
    document.getElementById('stat-active').textContent = manifest.active_count?.toLocaleString() || '—';
    if (manifest.generated_at) {
      const d = new Date(manifest.generated_at);
      document.getElementById('stat-updated').textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    currentServices = featured.slice();
    applyFilters();
  } catch(e) {
    document.getElementById('loading-state').innerHTML =
      '<div class="dir-loading__inner">Failed to load. <a href="https://github.com/Haustorium12/gold-402" target="_blank" style="color:var(--gold)">View on GitHub ↗</a></div>';
  }
}

// Events
document.getElementById('search').addEventListener('input', e => {
  searchQuery = (e.target as HTMLInputElement).value;
  document.getElementById('search-clear').style.display = searchQuery ? 'block' : 'none';
  applyFilters();
});
document.getElementById('search-clear').addEventListener('click', () => {
  (document.getElementById('search') as HTMLInputElement).value = '';
  searchQuery = '';
  document.getElementById('search-clear').style.display = 'none';
  applyFilters();
});
document.getElementById('type-pills').addEventListener('click', e => {
  const pill = (e.target as Element).closest('.dir-pill');
  if (!pill) return;
  document.querySelectorAll('#type-pills .dir-pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  activeType = (pill as HTMLElement).dataset.value;
  loadCurrentView();
});
document.getElementById('domain-pills').addEventListener('click', e => {
  const pill = (e.target as Element).closest('.dir-pill');
  if (!pill) return;
  document.querySelectorAll('#domain-pills .dir-pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  activeDomain = (pill as HTMLElement).dataset.value;
  loadCurrentView();
});
document.getElementById('verified-only').addEventListener('change', e => {
  verifiedOnly = (e.target as HTMLInputElement).checked;
  applyFilters();
});
document.getElementById('prev-page').addEventListener('click', () => {
  if (currentPage > 1) { currentPage--; render(); window.scrollTo(0,0); }
});
document.getElementById('next-page').addEventListener('click', () => {
  if (currentPage < Math.ceil(filtered.length / PAGE_SIZE)) { currentPage++; render(); window.scrollTo(0,0); }
});

function clearAll() {
  searchQuery = ''; activeType = 'all'; activeDomain = 'all'; verifiedOnly = false;
  (document.getElementById('search') as HTMLInputElement).value = '';
  (document.getElementById('verified-only') as HTMLInputElement).checked = false;
  document.querySelectorAll('.dir-pill').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.dir-pill[data-value="all"]').forEach(p => p.classList.add('active'));
  loadCurrentView();
}
document.getElementById('clear-filters').addEventListener('click', clearAll);
document.getElementById('clear-filters-2').addEventListener('click', clearAll);

init();
</script>

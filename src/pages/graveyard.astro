---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listings } from '../lib/listings.js';
import Touchstone from '../components/Touchstone.astro';

// THE GRAVEYARD — specs/GRAVEYARD_v0.1.md, commissioned by Sean 2026-08-26:
// "We just...move the listing to the graveyard page. With a gravestone badge that
// displays how long it's been on the graveyard list."
//
// The one rule on this page, and it is the only rule: THE STONE DISPLAYS A MEASUREMENT,
// NEVER A VERDICT. "No answer for 47 days" is a fact about a machine we knocked on and
// can show our working for. "Abandoned" is a characterization of somebody's business,
// it is unfalsifiable, and plenty of live companies have an endpoint down for a month.
// We would be wrong, not merely rude. Nothing on this page renders an adjective.
//
// Everything else here is Sean's — the tone, the stones, the joke at the top. Standing
// correction, 2026-08-26: "I'm going to treat this as my list. How I want it to look and
// I'm not going to be concerned with the fact that it's a public website."
//
// Why this page is an asset and not a dustbin: every competitor publishes who is UP. The
// dead silently vanish from x402scan, from CDP Bazaar, from every telemetry-badge player.
// A dated record of what stopped answering and when is a lane nobody occupies, and it
// cannot be acquired retroactively — you either kept the dates or you didn't.
//
// Prerendered at build. No JavaScript builds any of this.

const buried = listings.filter((e) => e.status === 'graveyard');
const live = listings.filter((e) => e.status !== 'graveyard');
const returned = listings.filter((e) => e.returned);

// THE BADGE CLOCK. Days are counted from the FIRST failed knock, not from the day we
// moved the entry — that is the true measurement and the more useful number. Computed
// against the build date so the figure is reproducible from the page's own stamp rather
// than drifting with the reader's clock.
const BUILT = new Date().toISOString().slice(0, 10);

function days(from, to) {
  if (!from) return null;
  const a = Date.parse(from + 'T00:00:00Z');
  const b = Date.parse(to + 'T00:00:00Z');
  if (Number.isNaN(a) || Number.isNaN(b)) return null;
  return Math.max(0, Math.round((b - a) / 86400000));
}

// "Last answered" is only sayable when we can actually distinguish an answer from a
// failure. `last_checked` moves only on a knock that ANSWERED — but that is a CORRECTION
// (scripts/merge_sweep.py), and rows stamped before it may carry a failure date under
// that field. So the subline is printed only when last_checked is strictly EARLIER than
// first_failed, which is the one case where the record is unambiguous. Otherwise the page
// says the record does not have it. An empty field is honest; a guessed date is not.
const rows = buried
  .map((e) => ({
    ...e,
    down: days(e.first_failed, BUILT),
    lastAnswered: e.last_checked && e.first_failed && e.last_checked < e.first_failed ? e.last_checked : null,
  }))
  .sort((a, b) => (b.down ?? -1) - (a.down ?? -1) || a.name.localeCompare(b.name));

// THE HONEST DENOMINATOR (spec §"the measured problem this walks into"). Step 2 of the
// line-in-the-sand sequence is to open an issue on the entry's repo before it moves. Two
// thirds of the shelf links no repo, so for most residents there was nobody to tell. The
// page says so out loud. A graveyard that admits it couldn't reach most of them is
// trustworthy; one that implies everyone got a fair shake is not.
const REPO = /(github|gitlab)\.com\//i;
const reachable = rows.filter((e) => REPO.test(e.desc || '') || REPO.test(e.url || '')).length;

function verb(e) {
  const d = (e.desc || '').replace(/\s+/g, ' ').trim();
  if (!d) return '';
  const cut = d.split(/(?<=[.;])\s/)[0];
  return cut.length > 130 ? cut.slice(0, 127).trimEnd() + '…' : cut;
}
---

<BaseLayout
  title="The Graveyard — gold-402 | 24K Labs"
  description="Listings that stopped answering, with the date they stopped. Every stone shows a measured number of days, never a verdict. Services that answer again go straight back on the shelf."
  bare={true}
>
  <div class="yard">

    <header class="yard-mast">
      <div class="yard-mast__row">
        <span class="yard-mast__mark"><span data-touchstone>◆</span> 24K LABS</span>
        <span class="yard-mast__sub">THE GRAVEYARD</span>
      </div>
      <div class="yard-mast__rule"></div>

      <nav class="yard-crumb" aria-label="Breadcrumb">
        <a href="/wall/">Top</a>
        <span>:</span>
        <strong>The Graveyard</strong>
      </nav>

      <div class="yard-panel">
        <h1 class="yard-title">Here lie the endpoints that stopped answering</h1>
        <p class="yard-sub">Sorted longest&#8209;silent first. Nobody is buried for good.</p>

        <p class="yard-standing">
          Every service on the shelf gets knocked on. When one stops answering twice running,
          it moves here and a clock starts on the date of the <em>first</em> failed knock — not
          the day we moved it. The stone shows that number and nothing else.
        </p>

        <p class="yard-standing yard-standing--hard">
          <strong>A stone is a measurement, not a verdict.</strong> We can say an endpoint did not
          answer us on a date, because we knocked and kept the receipt. We cannot say a business
          is gone, and we will not. Plenty of working companies have an endpoint down for a month.
        </p>

        <div class="yard-chips">
          <span class="yard-chip"><b>{rows.length}</b> resident{rows.length === 1 ? '' : 's'}</span>
          <span class="yard-chip"><b>{live.length}</b> still on the shelf</span>
          <span class="yard-chip"><b>{returned.length}</b> answered again and went back</span>
          <span class="yard-chip"><b>{reachable}</b> of {rows.length} could be told</span>
        </div>
      </div>

      <p class="yard-mast__standing">
        <strong>{reachable}</strong> of these <strong>{rows.length}</strong> link a repository, which is
        the only way we have to tell an operator their endpoint is down. For the rest there was
        nobody to write to, so they arrived here without a warning we were able to send. That is
        worth saying plainly rather than leaving a reader to assume everyone got a fair shake.
        We do the reasonable thing once and then we stop — that is the whole policy, published in
        advance and applied the same way to everybody.
      </p>
    </header>

    <main>
      {rows.length === 0 ? (
        <p class="yard-empty">
          Nobody is buried here yet. The yard opened empty on purpose — we have no dated failure
          history from before the sweep started, and a backfilled grave would be a fabricated date.
          It fills forward, one honest knock at a time.
        </p>
      ) : (
        <ul class="yard-list">
          {rows.map((e) => (
            <li class="stone">
              <div class="stone__top">
                <a class="stone__a" href={`/listing/${e.slug}/`}>{e.name}</a>
                <span class="stone__shelf">{e.section_label}</span>
              </div>

              <p class="stone__badge">
                {e.down === null
                  ? <span class="stone__days stone__days--none">No start date on record</span>
                  : <><span class="stone__days">No answer for {e.down} day{e.down === 1 ? '' : 's'}</span></>}
              </p>

              <p class="stone__sub">
                {e.lastAnswered
                  ? <>Last answered <time datetime={e.lastAnswered}>{e.lastAnswered}</time>.</>
                  : <>Last answer not on record — the sweep began stamping answers separately from
                     failures after this entry stopped, so we will not put a date to it.</>}
                {e.first_failed ? <> First failed knock <time datetime={e.first_failed}>{e.first_failed}</time>.</> : null}
              </p>

              <p class="stone__v">{verb(e)}</p>
              <p class="stone__url"><span>{e.url}</span></p>
            </li>
          ))}
        </ul>
      )}
    </main>

    <section class="yard-note">
      <h2 class="yard-h"><span>Coming back</span></h2>
      <p>
        This is not a ban and it is not a punishment. Any entry here that answers a knock again
        goes straight back on the live shelf — no appeal, no re&#8209;submission, no penance, and
        nothing held against it afterwards. The record of the silence stays, because
        <em> down twenty&#8209;three days, came back</em> is a more interesting fact about this
        ecosystem than either <em>up</em> or <em>gone</em>.
      </p>
      <p>
        If you run something on this page: the fastest way off it is to make the endpoint answer.
        We will knock again tonight either way. Some operators find out their service is down
        from us, and that is the most useful thing this page does.
      </p>
    </section>

    <nav class="yard-rail" aria-label="Elsewhere">
      <h2 class="yard-h"><span>The rest of the index</span></h2>
      <p>
        <a href="/wall/">the whole index</a> · <a href="/directory">the directory</a> ·
        <a href="/verify">verify an endpoint</a> ·
        <a href="/api/directory/search?q=">search, free</a> ·
        <a href="/graveyard.json">this page, as JSON</a>
      </p>
    </nav>

    <footer class="yard-foot">
      <div class="yard-mast__rule"></div>
      <p>
        Counted at build, <time datetime={BUILT}>{BUILT}</time>. Day counts run from the first
        failed knock to that date. Reading is never gated — static, free, no key.
      </p>
    </footer>
  </div>
  <Touchstone />
</BaseLayout>

<style>
  .yard { max-width: 1100px; margin: 0 auto; padding: 28px 18px 64px; font-size: 13px; line-height: 1.45; }

  .yard-mast__row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .yard-mast__mark { font-family: var(--mono); font-weight: 700; font-size: 15px; letter-spacing: 0.16em; color: var(--gold); }
  .yard-mast__sub { font-family: var(--mono); font-size: 11px; letter-spacing: 0.3em; color: var(--text-dim); }
  .yard-mast__rule { height: 1px; margin: 10px 0 12px; background: linear-gradient(90deg, var(--gold) 0%, var(--gold-dim) 42%, var(--border) 100%); }

  .yard-crumb { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); margin-bottom: 10px; }
  .yard-crumb a { color: var(--text-muted); text-decoration: none; }
  .yard-crumb a:hover { color: var(--gold-light); }
  .yard-crumb strong { color: var(--text); font-weight: 500; }

  /* The panel is the one place with any theatre. Slate, a hairline frame, corner ticks. */
  .yard-panel {
    position: relative;
    background: linear-gradient(180deg, rgba(140,150,165,0.055), transparent 70%);
    border: 1px solid var(--border);
    padding: 16px 18px 17px;
    margin-bottom: 20px;
  }
  .yard-panel::before, .yard-panel::after { content: ''; position: absolute; width: 7px; height: 7px; pointer-events: none; }
  .yard-panel::before { top: -1px; left: -1px; border-top: 1px solid #8f97a5; border-left: 1px solid #8f97a5; }
  .yard-panel::after { bottom: -1px; right: -1px; border-bottom: 1px solid #8f97a5; border-right: 1px solid #8f97a5; }

  .yard-title {
    margin: 0 0 4px; padding-bottom: 7px;
    border-bottom: 3px double #8f97a5;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 21px; font-weight: 700; letter-spacing: 0.02em; color: var(--gold);
  }
  .yard-sub { margin: 8px 0 0; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); }

  .yard-standing { margin: 12px 0 0; max-width: 76ch; color: var(--text-muted); font-size: 12.5px; line-height: 1.5; border-left: 2px solid #8f97a5; padding-left: 11px; }
  .yard-standing--hard { border-left-color: var(--gold); }
  .yard-standing strong { color: var(--text); }
  .yard-standing em { color: var(--text); font-style: italic; }

  .yard-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .yard-chip { font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); border: 1px solid var(--border); border-left: 2px solid #8f97a5; padding: 2px 8px; }
  .yard-chip b { color: var(--text); font-variant-numeric: tabular-nums; }

  .yard-mast__standing { margin: 0 0 24px; max-width: 82ch; color: var(--text-muted); font-size: 12.5px; }
  .yard-mast__standing strong { color: var(--text); font-family: var(--mono); }

  .yard-empty { max-width: 74ch; color: var(--text-muted); font-size: 13px; border-left: 2px solid var(--border); padding-left: 12px; }

  /* THE STONES. Flat top, shoulders, a base line — a marker shape, not a card. */
  .yard-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .stone {
    position: relative;
    background: #101017;
    border: 1px solid var(--border);
    border-top: 2px solid #8f97a5;
    border-radius: 9px 9px 2px 2px;
    padding: 13px 15px 12px;
  }
  .stone::after {
    content: ''; position: absolute; left: 10%; right: 10%; bottom: -4px; height: 3px;
    background: var(--border); border-radius: 1px;
  }
  .stone__top { display: flex; align-items: baseline; gap: 10px; }
  .stone__a { color: var(--text); text-decoration: none; font-weight: 600; font-size: 14px; }
  .stone__a:hover, .stone__a:focus-visible { color: var(--gold-light); text-decoration: underline; }
  .stone__shelf { margin-left: auto; font-family: var(--mono); font-size: 10px; color: var(--text-dim); white-space: nowrap; }

  .stone__badge { margin: 9px 0 0; }
  .stone__days {
    display: inline-block; font-family: var(--mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.04em; color: #c9ced8; font-variant-numeric: tabular-nums;
    border: 1px solid #4a5261; border-left: 3px solid #8f97a5; padding: 3px 9px; background: #0b0b12;
  }
  .stone__days--none { color: var(--text-dim); border-left-color: var(--border); }

  .stone__sub { margin: 8px 0 0; font-size: 11.5px; color: var(--text-muted); line-height: 1.45; }
  .stone__sub time { font-family: var(--mono); color: var(--gold-light); }
  .stone__v { margin: 8px 0 0; font-size: 11.5px; color: var(--text-muted); line-height: 1.4; }
  .stone__url { margin: 7px 0 0; font-family: var(--mono); font-size: 10px; color: var(--text-dim); overflow-wrap: anywhere; }

  .yard-note { margin-top: 40px; }
  .yard-note p { max-width: 82ch; color: var(--text-muted); font-size: 12.5px; margin: 9px 0; }
  .yard-note em { color: var(--text); font-style: italic; }

  .yard-h { display: flex; align-items: baseline; gap: 9px; margin: 0 0 9px; padding-bottom: 5px;
            border-bottom: 1px solid var(--gold-dim); font-size: 12px; font-weight: 700;
            letter-spacing: 0.13em; text-transform: uppercase; color: var(--gold); }

  .yard-rail { margin-top: 36px; }
  .yard-rail p { color: var(--text-dim); font-size: 12px; }
  .yard-rail a { color: var(--text-muted); }

  .yard-foot { margin-top: 30px; color: var(--text-dim); font-size: 11.5px; }
  .yard-foot p { margin: 8px 0; max-width: 82ch; }
  .yard-foot time { font-family: var(--mono); }

  @media (max-width: 900px) {
    .yard { font-size: 14px; padding: 20px 14px 48px; }
    .yard-list { grid-template-columns: 1fr; }
  }
</style>
